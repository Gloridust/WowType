+/// 只走精确全拼边、最多 depth 个音节的切法（实验 C）。
+fn exact_segmentations(
+    graph: &SyllableGraph,
+    pos: usize,
+    depth: usize,
+    path: &mut Vec<crate::graph::Edge>,
+    out: &mut Vec<Vec<crate::graph::Edge>>,
+) {
+    if pos == graph.len() {
+        out.push(path.clone());
+        return;
+    }
+    if depth == 0 || out.len() >= 8 {
+        return;
+    }
+    for edge in graph.edges_from(pos) {
+        if edge.typo
+            || edge.completion > 0
+            || !matches!(edge.kind, crate::graph::EdgeKind::Full { erhua: false, .. })
+        {
+            continue;
+        }
+        path.push(*edge);
+        exact_segmentations(graph, edge.end, depth - 1, path, out);
+        path.pop();
+    }
+}
+
+/// 实验开关：WT_X 里含某个字母就打开对应的实验。
+fn xp(flag: char) -> bool {
+    std::env::var("WT_X").map(|v| v.contains(flag)).unwrap_or(false)
+}
+fn xnum(name: &str, default: f64) -> f64 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
