+            MemoryLexicon::from_tsv_str("he\t和\t100000\nhe\t何\t10000\nhe\t合\t1000\n").unwrap(),
+        );
+        let e = Engine::new(lexicon, Arc::new(SentenceStartBoost));
+        let texts: Vec<String> = e.input("he").into_iter().map(|c| c.text).collect();
