def unquote_value(value):
    """两边有双引号的值去掉引号，再把反斜杠、引号、换行的转义还原（和 fcitx5 读 wowtype.conf 一样）。"""
    if len(value) < 2 or value[0] != '"' or value[-1] != '"':
        return value
    out, escaped = [], False
    for c in value[1:-1]:
        if escaped:
            out.append("\n" if c == "n" else c)
            escaped = False
        elif c == "\\":
            escaped = True
        else:
            out.append(c)
    return "".join(out)


def normalize_value(key, value):
    """按插件的读法认这一项的值；认不出的（开关写成 true、枚举大小写不对、数字写成 abc）是默认值，
    数字超出范围夹到边上。三端一样，见 spec/config.json 的 readRules。"""
    default = DEFAULTS[key]
    if default in ("True", "False"):
        return value if value in ("True", "False") else default
    if key in ENUMS:
        return value if value in ENUMS[key] else default
    if key in RANGES:
        low, high = RANGES[key]
        try:
            return str(min(max(int(value), low), high))
        except ValueError:
            return default
    return value


def read_config():
    """读 wowtype.conf，返回 (值, 原文里不认识的行)。

    [分组]（fcitx5 的 [Hotkey] 等）下面的行不是设置项，原样放进「不认识的行」，写回时留着。"""
    values = dict(DEFAULTS)
    extra = []
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return values, extra
    seen = set()
    old_shuangpin = False
    in_group = False
    for line in lines:
        if line.strip().startswith("["):
            in_group = True
        key, sep, value = line.partition("=")
        key = key.strip()
        if not in_group and sep and key in DEFAULTS:
            values[key] = normalize_value(key, unquote_value(value.strip()))
            seen.add(key)
        elif not in_group and sep and key == "Shuangpin":
            # 0.3.12 及以前的双拼开关：只在没有 InputScheme 时算，不放进「不认识的行」，下次存盘就没了
            old_shuangpin = unquote_value(value.strip()) == "True"
        elif line.strip():
            extra.append(line)
    # 0.3.10 及以前没有 TranslateLocal：已经填好翻译接口的，接着用接口（设置里默认是本地模型）
    if "TranslateLocal" not in seen and values["TranslateBaseUrl"].strip():
        values["TranslateLocal"] = "False"
    if "InputScheme" not in seen and old_shuangpin:
        values["InputScheme"] = "Shuangpin"
    return values, extra


