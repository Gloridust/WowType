def kimpanel_settings():
    """Input Method Panel 扩展的 gsettings（GNOME 上候选框的字体在这里）；没装时 None。

    扩展装在用户目录时 schema 不在系统里，要从扩展的 schemas 目录读。
    """
    source = Gio.SettingsSchemaSource.get_default()
    schema = source.lookup(KIMPANEL_SCHEMA, True) if source else None
    if schema is None:
        for base in (os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), "gnome-shell", "extensions"),
                     "/usr/share/gnome-shell/extensions"):
            directory = os.path.join(base, KIMPANEL_EXT, "schemas")
            if not os.path.exists(os.path.join(directory, "gschemas.compiled")):
                continue
            try:
                local = Gio.SettingsSchemaSource.new_from_directory(directory, source, False)
            except GLib.Error:
                continue
            schema = local.lookup(KIMPANEL_SCHEMA, False)
            if schema is not None:
                break
    if schema is None or not schema.has_key("font"):
        return None
    return Gio.Settings.new_full(schema, None, None)


def font_size(font, default):
    """「Sans 11」「Noto Sans CJK SC Bold 12」里的字号（磅）；没写字号时 default。"""
    size = Pango.FontDescription.from_string(font or "").get_size() / Pango.SCALE
    return size if size > 0 else default


def font_with_size(font, size):
    """字体换成 size 号，字体名和粗细不变：「Sans Bold 11」+ 14 →「Sans Bold 14」。"""
    desc = Pango.FontDescription.from_string(font or "Sans")
    desc.set_size(int(round(size * Pango.SCALE)))
    return desc.to_string()


