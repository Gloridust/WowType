def remove_legacy_model(models_dir=None):
    """新模型下好以后删掉上一代的（连同没下完的 .part）。返回空出多少字节。"""
    models_dir = models_dir or MODELS_DIR
    if not os.path.isfile(os.path.join(models_dir, LOCAL_MODEL_FILE)):
        return 0
    freed = 0
    for name in (LEGACY_MODEL_FILE, LEGACY_MODEL_FILE + ".part"):
