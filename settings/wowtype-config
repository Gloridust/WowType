# ---- 数据版本标记（docs/DATA.md「数据版本标记」）。和插件的 data_files.h、core/src/datamark.rs、
# tools/datamark.py 同一套规则：文件前 4096 字节里有一串 `wowtype-data: <名字> <版本> [来源]`，
# 以换行或 \0 结束；文本文件是头部一行注释，words.lm（WTLM 版本 1）是词表的 1 号词。
# 版本是点分隔的数字，逐段按数字比，缺的段算 0。
DATA_MARKER_KEY = b"wowtype-data:"
DATA_MARKER_SCAN = 4096
_DATA_MARKER_NAME = re.compile(r"[\x21-\x7e]+")
_DATA_MARKER_VERSION = re.compile(r"[0-9]+(?:\.[0-9]+)*")


def parse_data_marker(text):
    """`... wowtype-data: 名字 版本 [来源]` -> (名字, 版本, 来源)，不合规矩返回 None。"""
    at = text.find(DATA_MARKER_KEY.decode())
    if at < 0:
        return None
    rest = re.split(r"[\n\r\0]", text[at + len(DATA_MARKER_KEY):], maxsplit=1)[0]
    if not rest.startswith(" "):
        return None
    name, _, rest = rest.lstrip(" ").partition(" ")
    version, _, source = rest.lstrip(" ").partition(" ")
    source = source.strip(" \t")
    if not (_DATA_MARKER_NAME.fullmatch(name) and _DATA_MARKER_VERSION.fullmatch(version)):
        return None
    return name, version, source


def scan_data_marker(head):
    """从文件开头的字节里找标记：WTLM 文件看词表 1 号词，别的找以换行或 \\0 结束的那一串。"""
    head = head[:DATA_MARKER_SCAN]
    if head.startswith(b"WTLM"):
        if len(head) < 17 or int.from_bytes(head[4:8], "little") != 1 \
                or int.from_bytes(head[8:12], "little") < 2:
            return None
        at = 17 + head[16]
        if at >= len(head):
            return None
        word = head[at + 1:at + 1 + head[at]]
        if len(word) != head[at] or not word.startswith(DATA_MARKER_KEY):
            return None
        return parse_data_marker(word.decode("utf-8", "replace"))
    at = head.find(DATA_MARKER_KEY)
    if at < 0 or not any(head.find(end, at) >= 0 for end in (b"\n", b"\r", b"\0")):
        return None
    return parse_data_marker(head[at:].decode("utf-8", "replace"))


def read_data_marker(path):
    try:
        with open(path, "rb") as f:
            return scan_data_marker(f.read(DATA_MARKER_SCAN))
    except OSError:
        return None


def compare_data_versions(a, b):
    """逐段按数字比，缺的段算 0；返回 -1、0、1。"""
    x = [int(n) for n in a.split(".")]
    y = [int(n) for n in b.split(".")]
    width = max(len(x), len(y))
    x += [0] * (width - len(x))
    y += [0] * (width - len(y))
    return (x > y) - (x < y)


def data_file_version(path, name=None):
    """数据文件的版本：(版本, 说明)，看不出来时返回 None。

    带标记的读标记（名字要和 name 一样，默认是文件名）；没有标记的 words.lm 字节数是加标记以前
    某一版官方发布的（OFFICIAL_LM_SIZES），就是那一版。"""
    name = name or os.path.basename(path)
    marker = read_data_marker(path)
    if marker:
        if marker[0] != name:
            return None
        return marker[1], marker[2]
    if name == "words.lm":
        try:
            legacy = OFFICIAL_LM_SIZES.get(os.path.getsize(path))
        except OSError:
            return None
        if legacy:
            return legacy, f"lm-{legacy}，没有标记，按字节数认出"
    return None


def read_data_manifest(path=DATA_MANIFEST):
    """系统数据目录里的清单：[(名字, 版本, 来源)]，没有清单（老安装包）返回 []。"""
    rows = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                cols = line.rstrip("\n").split("\t")
                if line.startswith("#") or len(cols) < 2:
                    continue
                rows.append((cols[0], cols[1], cols[3] if len(cols) > 3 else ""))
    except OSError:
        pass
    return rows


