    def on_test_translate(self, _button):
        base = self.url_row.get_text().strip()
        model = self.tmodel_row.get_text().strip()
        key = self.key_entry.get_text().strip()
        if not base or not model:
            self.test_row.set_subtitle("先填接口地址和模型")
            return
        target = self.target_codes[self.target_row.get_selected()]
        self.test_button.set_sensitive(False)
        self.test_row.set_subtitle("正在连接…")

        def work():
            try:
                text, seconds = test_translate(base, key, model, target)
                result = (text, seconds, None)
            except TranslateError as e:
                result = (None, 0, str(e))
            GLib.idle_add(self.test_finished, *result)
        threading.Thread(target=work, daemon=True).start()

    def test_finished(self, text, seconds, error):
        self.test_button.set_sensitive(True)
        if error:
            self.test_row.set_subtitle(GLib.markup_escape_text(f"✗ {error}"))
            log(f"测试翻译服务失败：{error}")
            return
        message = f"✓ 你好 → {text}（{seconds:.1f} 秒）"
        if seconds > 2.5:
            message += "。有点慢，打字时得等一会儿，可以换个小一点的模型"
        self.test_row.set_subtitle(GLib.markup_escape_text(message))
        log(f"测试翻译服务成功（{seconds:.1f} 秒）")

