_open_choosers = set()  # 原生文件对话框没人引用会被回收，开着的时候留在这里


class _FileDialog:
    """Gtk.FileDialog（4.10）换成 Gtk.FileChooserNative；取消时 *_finish 抛 GLib.Error，跟原生一样。"""

    def __init__(self, title="", initial_name=None):
        self.title, self.initial_name = title, initial_name
        self.filters, self.folder, self.file = [], None, None

    def set_filters(self, filters):
        self.filters = [filters.get_item(i) for i in range(filters.get_n_items())]

    def set_initial_folder(self, folder):
        self.folder = folder

    def _run(self, parent, action, callback):
        chooser = Gtk.FileChooserNative(title=self.title, transient_for=parent, modal=True,
                                        action=action)
        for item in self.filters:
            chooser.add_filter(item)
        if self.initial_name:
            chooser.set_current_name(self.initial_name)
        if self.folder is not None:
            try:
                chooser.set_current_folder(self.folder)
            except GLib.Error:
                pass

        def done(chooser, response):
            _open_choosers.discard(chooser)
            self.file = chooser.get_file() if response == Gtk.ResponseType.ACCEPT else None
            chooser.destroy()
            callback(self, None)
        chooser.connect("response", done)
        _open_choosers.add(chooser)
        chooser.show()

    def open(self, parent, _cancellable, callback):
        self._run(parent, Gtk.FileChooserAction.OPEN, callback)

    def save(self, parent, _cancellable, callback):
        self._run(parent, Gtk.FileChooserAction.SAVE, callback)

    def open_finish(self, _result):
        if self.file is None:
            raise GLib.Error("没选文件")
        return self.file

    save_finish = open_finish


