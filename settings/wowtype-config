def read_translate_key(path=None):
    try:
        with open(path or TRANSLATE_KEY_FILE, encoding="utf-8") as f:
            return f.readline().strip()
    except OSError:
        return ""


def write_translate_key(key, path=None):
    """存 Key：文件只有自己能读写（0600），空串就删掉文件。"""
    path = path or TRANSLATE_KEY_FILE
    key = key.strip()
    if not key:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (key + "\n").encode("utf-8"))
    finally:
        os.close(fd)
    os.replace(tmp, path)


def _api_base(base):
    base = base.strip().rstrip("/")
    if base.endswith("/chat/completions"):
        base = base[: -len("/chat/completions")]
    return base


def chat_endpoint(base):
    """和 core/src/translate.rs 的 TranslateConfig::endpoint 一样。"""
    return _api_base(base) + "/chat/completions"


def models_endpoint(base):
    return _api_base(base) + "/models"


def is_loopback_url(url):
    host = urllib.parse.urlsplit(url.strip()).hostname or ""
    return host in ("localhost", "::1") or host.startswith("127.") or host.endswith(".localhost")


def provider_index(base):
    """接口地址对应 TRANSLATE_PROVIDERS 里的第几个，对不上就是最后的「其他」。"""
    base = _api_base(base)
    for i, (_name, url, _model) in enumerate(TRANSLATE_PROVIDERS):
        if url and _api_base(url) == base:
            return i
    return len(TRANSLATE_PROVIDERS) - 1


def mask_url(url):
    """诊断信息里只留协议和主机（有的代理把 Key 放在路径里）。"""
    parts = urllib.parse.urlsplit(url.strip())
    return f"{parts.scheme}://{parts.netloc.rpartition('@')[2]}/…" if parts.netloc else ""


class TranslateError(Exception):
    pass


def api_request(url, key, body=None, timeout=20):
    """调一次 OpenAI 格式的接口，返回解析好的 JSON；出错抛 TranslateError（给人看的话，抹掉了 Key）。"""
    headers = {"User-Agent": f"WowType/{current_version()}", "Accept": "application/json"}
    if key:
        headers["Authorization"] = f"Bearer {key}"
    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers)
    # 本机的服务（Ollama 等）不走代理
    handlers = [urllib.request.ProxyHandler({})] if is_loopback_url(url) else []
    opener = urllib.request.build_opener(*handlers)

    def clean(text):
        text = text.replace(key, "***") if key and len(key) >= 4 else text
        return text if len(text) <= 160 else text[:160] + "…"
    try:
        with opener.open(request, timeout=timeout) as response:
            raw = response.read()
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            payload = json.loads(e.read().decode("utf-8", "replace"))
            error = payload.get("error")
            detail = (error.get("message") if isinstance(error, dict) else error) \
                or payload.get("message") or payload.get("detail") or ""
        except (ValueError, AttributeError, OSError):
            pass
        hint = {401: "Key 不对", 403: "没有权限", 404: "地址或模型不对", 429: "请求太多或额度用完了"}.get(e.code)
        text = f"服务返回 {e.code}" + (f"（{hint}）" if hint else "")
        raise TranslateError(clean(f"{text}：{detail}" if detail else text)) from None
    except urllib.error.URLError as e:
        reason = e.reason
        if isinstance(reason, TimeoutError) or "timed out" in str(reason):
            raise TranslateError("请求超时") from None
        raise TranslateError(clean(f"连不上：{reason}")) from None
    except TimeoutError:
        raise TranslateError("请求超时") from None
    except OSError as e:
        raise TranslateError(clean(f"连不上：{e}")) from None
    try:
        return json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        raise TranslateError("看不懂服务的返回（是 OpenAI 格式的接口吗？）") from None


def fetch_models(base, key):
    data = api_request(models_endpoint(base), key, timeout=15)
    items = data.get("data") if isinstance(data, dict) else None
    if not isinstance(items, list):
        items = data.get("models", []) if isinstance(data, dict) else []
    ids = {item.get("id") or item.get("name") for item in items if isinstance(item, dict)}
    return sorted((i for i in ids if isinstance(i, str) and i), key=str.lower)


def strip_think(text):
    return re.sub(r"<think>.*?(</think>|$)", "", text, flags=re.S).strip()


def test_translate(base, key, model, target="en", text="你好"):
    """用一句话试一下服务，返回 (译文, 秒数)。"""
    language = next((en for _, code, en in TRANSLATE_LANGUAGES if code == target), "English")
    body = {
        "model": model.strip(),
        "messages": [
            {"role": "system", "content": f"Translate the user's text into {language}. "
                                          "Output only the translation."},
            {"role": "user", "content": text},
        ],
    }
    start = time.monotonic()
    data = api_request(chat_endpoint(base), key, body, timeout=45)
    seconds = time.monotonic() - start
    try:
        content = data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        raise TranslateError("看不懂服务的返回（是 OpenAI 格式的接口吗？）") from None
    result = strip_think(content or "")
    if not result:
        raise TranslateError("服务返回了空的译文")
    return result.splitlines()[0], seconds


def dir_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += os.path.getsize(os.path.join(root, name))
            except OSError:
                pass
    return total


