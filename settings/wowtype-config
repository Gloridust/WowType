class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None
        self.add_main_option("page", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "打开时显示的页面：general、input、emoji、voice、translate、words、update", "页面")

    def do_startup(self):
        Adw.Application.do_startup(self)
        # 跟在英文后面的「、」「。」，Pango 会去找第一个有这个字的字体，常常找到蒙古文字体，
        # 标点画在格子正中间。在系统界面字体后面接上简体中文字体，让它先找到这些。
        self.font_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.font_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        settings = Gtk.Settings.get_default()
        settings.connect("notify::gtk-font-name", lambda *_: self.update_font_css())
        self.update_font_css()
        # 微信输入法风格的配色，深色模式换一套
        self.style_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.style_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        manager = Adw.StyleManager.get_default()
        manager.connect("notify::dark", lambda *_: self.update_style_css())
        self.update_style_css()

    def update_font_css(self):
        name = Gtk.Settings.get_default().props.gtk_font_name or "Sans 11"
        family = Pango.FontDescription.from_string(name).get_family() or "Sans"
        families = [family] + [f for f in CJK_SC_FONTS if f != family]
        quoted = ", ".join('"' + f.replace('"', "") + '"' for f in families)
        self.font_css.load_from_string(f"window {{ font-family: {quoted}; }}")

    def update_style_css(self):
        dark = Adw.StyleManager.get_default().get_dark()
        accent_text = "#3CCB93" if dark else "#0a8a5c"
        css = (STYLE_DARK if dark else STYLE_LIGHT) + STYLE_ACCENT % accent_text
        if (Gtk.get_major_version(), Gtk.get_minor_version()) >= (4, 16):
            css += STYLE_ACCENT_VARS % accent_text
        self.style_css.load_from_string(css)

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        self.page = options.get("page")
        self.activate()
        return 0

    def do_activate(self):
        Gtk.Window.set_default_icon_name("wowtype")
        window = self.props.active_window
        if not window:
            window = SettingsWindow(self, self.page)
        elif self.page:
            window.show_page(self.page)
        window.present()


