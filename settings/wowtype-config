    def on_word_changed(self, _entry):
        # 查词库要几十毫秒，打字停一下再查
        if self.guess_source:
            GLib.source_remove(self.guess_source)
        self.guess_source = GLib.timeout_add(150, self.fill_pinyin)
        self.update_add_button()

    def fill_pinyin(self):
        self.guess_source = 0
        word = self.word_entry.get_text().strip()
        if not self.pinyin_edited:
            guess = self.guesser.guess(word) if word else ""
            self.pinyin_entry.handler_block_by_func(self.on_pinyin_changed)
            self.pinyin_entry.set_text(guess or "")
            self.pinyin_entry.handler_unblock_by_func(self.on_pinyin_changed)
        self.update_add_button()
        return GLib.SOURCE_REMOVE

    def on_pinyin_changed(self, entry):
        self.pinyin_edited = bool(entry.get_text().strip())
        self.update_add_button()

    def update_add_button(self):
        word = self.word_entry.get_text().strip()
        pinyin = normalize_pinyin(self.pinyin_entry.get_text())
        ok = bool(word) and pinyin is not None and "\t" not in word
        self.add_button.set_sensitive(ok)
        if self.pinyin_entry.get_text().strip() and pinyin is None:
            self.pinyin_entry.add_css_class("error")
        else:
            self.pinyin_entry.remove_css_class("error")

    def on_add_word(self, *_args):
        if self.guess_source:
            GLib.source_remove(self.guess_source)
            self.fill_pinyin()
        word = self.word_entry.get_text().strip()
        pinyin = normalize_pinyin(self.pinyin_entry.get_text())
        if not word or pinyin is None:
            if word:
                self.toast("拼音不对：用空格隔开音节，比如 zhang san")
            return
        replaced = any(w == word for _, w in self.words)
        self.words = [(p, w) for p, w in self.words if w != word] + [(pinyin, word)]
        self.save_words()
        self.word_entry.set_text("")
        self.pinyin_edited = False
        self.pinyin_entry.set_text("")
        self.pinyin_edited = False
        self.update_add_button()
        self.word_entry.grab_focus()
        self.toast(f"已更新「{word}」" if replaced else f"已添加「{word}」，打 {pinyin.replace(' ', '')} 试试")

    def remove_word(self, word):
        removed = [(p, w) for p, w in self.words if w == word]
        self.words = [(p, w) for p, w in self.words if w != word]
        self.save_words()
        toast = Adw.Toast(title=GLib.markup_escape_text(f"已删除「{word}」"), button_label="撤销")

        def undo(_toast):
            self.words += removed
            self.save_words()
        toast.connect("button-clicked", undo)
        self.toasts.add_toast(toast)

    def save_words(self):
        try:
            write_custom_words(self.words)
        except OSError as e:
            self.toast(f"保存失败：{e.strerror}")
            return
        self.fcitx.reload()
        self.rebuild_word_list()

    def rebuild_word_list(self):
        while (child := self.word_box.get_first_child()) is not None:
            self.word_box.remove(child)
        query = self.search.get_text().strip().lower()
        shown = [(p, w) for p, w in reversed(self.words)
                 if not query or query in w.lower() or query.replace(" ", "") in p.replace(" ", "")]
        self.list_group.set_title(f"我的词（{len(self.words)}）" if self.words else "我的词")
        self.search.set_visible(len(self.words) > 8)
        if not shown:
            empty = Adw.ActionRow(title="还没有自定义词" if not self.words else "没找到")
            empty.add_css_class("dim-label")
            self.word_box.append(empty)
            return
        for pinyin, word in shown[:500]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(word), subtitle=pinyin)
            button = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="删除",
                                valign=Gtk.Align.CENTER)
            button.add_css_class("flat")
            button.connect("clicked", lambda _b, w=word: self.remove_word(w))
            row.add_suffix(button)
            self.word_box.append(row)

    # ---------------- 保存

    def set_value(self, key, value):
        if self.values.get(key) == value:
            return
        self.values[key] = value
        # 拖动数字框时不要每一下都写文件
        if self.save_source:
            GLib.source_remove(self.save_source)
        self.save_source = GLib.timeout_add(250, self.save_config)

    def save_config(self):
        self.save_source = 0
        try:
            write_config(self.values, self.extra)
        except OSError as e:
            self.toast(f"保存失败：{e.strerror}")
            return GLib.SOURCE_REMOVE
        self.fcitx.reload()
        return GLib.SOURCE_REMOVE

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=3))

    # ---------------- 菜单

    def on_open_custom(self, *_args):
        if not os.path.exists(CUSTOM_FILE):
            write_custom_words(self.words)
        Gtk.FileLauncher.new(Gio.File.new_for_path(CUSTOM_FILE)).launch(self, None, None)

    def on_reset(self, *_args):
        dialog = Adw.AlertDialog(heading="恢复默认设置？",
                                 body="排列方向、模糊音、语音键等回到默认值。自定义词不受影响。")
        dialog.add_response("cancel", "取消")
        dialog.add_response("reset", "恢复默认")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)

        def answered(_dialog, response):
            if response != "reset":
                return
            self.values = dict(DEFAULTS)
            self.save_config()
            self.layout_row.set_selected(0)
            self.page_row.set_value(9)
            for key, row in self.switches.items():
                row.set_active(DEFAULTS[key] == "True")
            self.key_row.set_selected(self.voice_keys.index(DEFAULTS["VoiceKey"]))
            self.toast("已恢复默认设置")
        dialog.connect("response", answered)
        dialog.present(self)

    def on_about(self, *_args):
        about = Adw.AboutDialog(
            application_name="WowType",
            application_icon="input-keyboard",
            developer_name="Gloridust",
            version=VERSION if not VERSION.startswith("@") else "dev",
            website=HOMEPAGE,
            issue_url=HOMEPAGE + "/issues",
            license_type=Gtk.License.CUSTOM,
            license="代码按 MIT 或 Apache-2.0 双许可证发布。\n"
                    "词库数据来自 rime-ice（GPL-3.0）。\n"
                    "语音模型属于腾讯微信输入法，使用时从腾讯服务器下载，不随 WowType 分发。",
            comments="好用的拼音输入法：整句、简拼、按错键纠正、语音输入。")
        about.present(self)


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None
        self.add_main_option("page", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "打开时显示的页面：general、voice、words", "页面")

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        self.page = options.get("page")
        self.activate()
        return 0

    def do_activate(self):
        window = self.props.active_window
        if not window:
            window = SettingsWindow(self, self.page)
        elif self.page:
            window.stack.set_visible_child_name(self.page)
        window.present()


