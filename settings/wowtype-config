        assert chat_endpoint("https://x/v1/") == "https://x/v1/chat/completions"
        assert chat_endpoint("https://x/v1/chat/completions") == "https://x/v1/chat/completions"
        assert models_endpoint("https://x/v1/chat/completions") == "https://x/v1/models"
        assert provider_index("https://api.deepseek.com/v1/") == 1
        assert provider_index("https://example.com/v1") == len(TRANSLATE_PROVIDERS) - 1
        assert is_loopback_url("http://127.0.0.1:11434/v1") and is_loopback_url("http://localhost/v1")
        assert not is_loopback_url("https://api.openai.com/v1")
        assert mask_url("https://user:tok@proxy.example.com/abc/v1") == "https://proxy.example.com/…"
        assert [code for _, code, _ in TRANSLATE_LANGUAGES][:3] == ["en", "ja", "ko"]
        assert strip_think("<think>嗯</think>Hello") == "Hello"
        with tempfile.TemporaryDirectory() as tmp:
            key_file = os.path.join(tmp, "wowtype", "translate.key")
            write_translate_key(" sk-test \n", key_file)
            assert read_translate_key(key_file) == "sk-test"
            assert os.stat(key_file).st_mode & 0o777 == 0o600
            write_translate_key("", key_file)
            assert not os.path.exists(key_file) and read_translate_key(key_file) == ""
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

        class Mock(BaseHTTPRequestHandler):
            def reply(self, code, payload):
                data = json.dumps(payload).encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self):
                self.reply(200, {"data": [{"id": "b-model"}, {"id": "A-model"}]})

            def do_POST(self):
                body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
                if self.headers.get("Authorization") != "Bearer sk-ok":
                    self.reply(401, {"error": {"message": "bad key sk-wrong"}})
                    return
                text = body["messages"][-1]["content"]
                self.reply(200, {"choices": [{"message": {"content": f"<think>x</think>T:{text}"}}]})

            def log_message(self, *_args):
                pass
        server = ThreadingHTTPServer(("127.0.0.1", 0), Mock)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{server.server_address[1]}/v1"
        assert fetch_models(base, "sk-ok") == ["A-model", "b-model"]
        assert test_translate(base, "sk-ok", "m")[0] == "T:你好"
        try:
            test_translate(base, "sk-wrong", "m")
            raise AssertionError("应该报 401")
        except TranslateError as e:
            assert "401" in str(e) and "Key 不对" in str(e) and "sk-wrong" not in str(e), e
        server.shutdown()
        try:
            test_translate(base, "sk-ok", "m")
            raise AssertionError("服务关了应该连不上")
        except TranslateError as e:
            assert "连不上" in str(e) or "超时" in str(e), e
        print("self-test ok")
        sys.exit(0)
    sys.exit(SettingsApp().run(sys.argv))
