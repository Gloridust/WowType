REPO = "Gloridust/WowType"
RELEASE_API = f"https://api.github.com/repos/{REPO}/releases/latest"
RELEASES_PAGE = f"{HOMEPAGE}/releases"
CACHE_DIR = os.path.join(_xdg("XDG_CACHE_HOME", "~/.cache"), "wowtype")
UPDATE_DIR = os.path.join(CACHE_DIR, "updates")
UPDATE_STATE = os.path.join(CACHE_DIR, "update-check.json")
ENGINE_PKG = "wowtype"
DATA_PKG = "wowtype-data-rime-ice"
# 自动检查最多这么久一次
CHECK_INTERVAL = 20 * 3600


def current_version():
    return VERSION if not VERSION.startswith("@") else "0"


def parse_version(text):
    """`v0.2.1`、`0.2.1-1~ubuntu26.04`、`2026.10.31` -> 数字元组。"""
    text = text.strip().lstrip("vV").split("-")[0].split("~")[0]
    return tuple(int(n) for n in re.findall(r"\d+", text))


def dpkg_version(package):
    """已装 deb 包的版本；没装（或不是 Debian 系）返回 None。"""
    try:
        out = subprocess.run(["dpkg-query", "-W", "-f=${Status}\t${Version}", package],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    status, _, version = out.stdout.partition("\t")
    return version if out.returncode == 0 and status.endswith(" installed") else None


def distro_tag():
    """和发布包文件名里的一样：ubuntu26.04、debian13。"""
    info = {}
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                key, sep, value = line.strip().partition("=")
                if sep:
                    info[key] = value.strip('"')
    except OSError:
        return ""
    return info.get("ID", "") + info.get("VERSION_ID", "")


def deb_arch():
    try:
        return subprocess.run(["dpkg", "--print-architecture"], capture_output=True,
                              text=True, timeout=10).stdout.strip() or "amd64"
    except (OSError, subprocess.SubprocessError):
        return "amd64"


def http_open(url, timeout=30):
    request = urllib.request.Request(url, headers={
        "User-Agent": f"WowType-Updater/{current_version()}",
        "Accept": "application/vnd.github+json" if "api.github.com" in url else "*/*",
    })
    return urllib.request.urlopen(request, timeout=timeout)


def fetch_latest():
    """GitHub 上最新的正式版：{tag, version, notes, url, assets: {文件名: 下载地址}}。"""
    with http_open(RELEASE_API, timeout=20) as response:
        data = json.load(response)
    return {
        "tag": data.get("tag_name", ""),
        "version": data.get("tag_name", "").lstrip("vV"),
        "notes": data.get("body") or "",
        "url": data.get("html_url") or RELEASES_PAGE,
        "assets": {a["name"]: a["browser_download_url"] for a in data.get("assets", [])},
    }


def is_newer(release):
    return parse_version(release["version"]) > parse_version(current_version())


def plan_update(release):
    """要下载的包：[(文件名, 地址)]，和一段说明。装不了时列表为空，说明里写原因。"""
    if dpkg_version(ENGINE_PKG) is None:
        return [], "当前不是用 deb 包安装的（比如从源码装的），请到下载页手动更新"
    distro = distro_tag()
    name = f"wowtype_{release['version']}_{distro}_{deb_arch()}.deb"
    if name not in release["assets"]:
        return [], f"这一版没有 {distro or '你的发行版'} 的安装包，请到下载页看看"
    files = [(name, release["assets"][name])]
    installed_data = dpkg_version(DATA_PKG)
    for asset, url in release["assets"].items():
        match = re.fullmatch(rf"{DATA_PKG}_(.+)_all\.deb", asset)
        if match and installed_data and parse_version(match.group(1)) > parse_version(installed_data):
            files.append((asset, url))
    return files, ""


def download_updates(release, files, progress):
    """下载并按 SHA256SUMS 校验，返回本地路径列表。progress(已下字节, 总字节)。"""
    folder = os.path.join(UPDATE_DIR, release["tag"])
    os.makedirs(folder, exist_ok=True)
    sums = {}
    if "SHA256SUMS" in release["assets"]:
        with http_open(release["assets"]["SHA256SUMS"]) as response:
            for line in response.read().decode("utf-8", "replace").splitlines():
                digest, _, name = line.strip().partition(" ")
                sums[name.strip().lstrip("*")] = digest
    paths = []
    for name, url in files:
        if name not in sums:
            raise RuntimeError(f"SHA256SUMS 里没有 {name}，不安装")
        path = os.path.join(folder, name)
        digest = hashlib.sha256()
        with http_open(url, timeout=60) as response, open(path + ".part", "wb") as out:
            total = int(response.headers.get("Content-Length") or 0)
            done = 0
            while chunk := response.read(1 << 16):
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                progress(done, total)
        if digest.hexdigest() != sums[name]:
            os.unlink(path + ".part")
            raise RuntimeError(f"{name} 校验和不对，可能没下完整，请重试")
        os.replace(path + ".part", path)
        paths.append(path)
    return paths


def read_update_state():
    try:
        with open(UPDATE_STATE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_update_state(state):
    try:
        write_atomic(UPDATE_STATE, json.dumps(state))
    except OSError:
        pass


def background_check():
    """fcitx5 切到 WowType 时在后台跑（wowtype-config --check-update）。

    一天最多查一次；有新版本就发一条桌面通知（同一版本只提醒一次），点开进设置的「更新」页。
    """
    values, _ = read_config()
    if values.get("CheckUpdate") != "True":
        return 0
    state = read_update_state()
    if time.time() - state.get("checked", 0) < CHECK_INTERVAL:
        return 0
    try:
        release = fetch_latest()
    except Exception:  # 没网、被限流：下次再说
        return 0
    state["checked"] = time.time()
    write_update_state(state)
    if not is_newer(release) or state.get("notified") == release["tag"]:
        return 0
    state["notified"] = release["tag"]
    write_update_state(state)
    try:
        chosen = subprocess.run(
            ["notify-send", "--app-name=WowType", "--icon=wowtype",
             "--action=open=查看更新", "--action=default=查看更新",
             f"WowType {release['version']} 可以更新了",
             f"当前是 {current_version()}。打开设置可以看更新内容，一键安装。"],
            capture_output=True, text=True, timeout=24 * 3600).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 0
    if chosen in ("open", "default"):
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), "--page", "update"])
    return 0

