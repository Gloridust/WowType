        dialog = Gtk.FileDialog(title="导出日志", initial_name=default_log_name())
        downloads = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
        if downloads and os.path.isdir(downloads):
            dialog.set_initial_folder(Gio.File.new_for_path(downloads))

        def chosen(dialog, result):
            try:
                file = dialog.save_finish(result)
            except GLib.Error:
                return  # 取消
            path = file.get_path()

            def work():
                try:
                    export_diagnostics(path)
                    GLib.idle_add(self.exported, path, None)
