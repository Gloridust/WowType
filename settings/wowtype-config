    import http.server
    import io
    import tempfile
    import zipfile

    def make_pack(inner_files):
        inner = io.BytesIO()
        with zipfile.ZipFile(inner, "w") as z:
            for name, data in inner_files.items():
                z.writestr(name, data)
        outer = io.BytesIO()
        with zipfile.ZipFile(outer, "w") as z:
            z.writestr("AndroidManifest.xml", b"x")
            z.writestr(VOICE_MODEL_INNER, inner.getvalue())
        return outer.getvalue()
    good = make_pack({"model/encoder.xnet": os.urandom(200_000), "model/decoder.xnet": b"d" * 1000,
                      f"model/{VOICE_MODEL_DICT}": "你\n好\n".encode(), "model/readme.txt": b"junk",
                      "../../evil.xnet": b"evil"})
    blob = {"data": good}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *_a):
            pass

        def do_GET(self):
            data = blob["data"]
            start = 0
            if rng := self.headers.get("Range"):
                start = int(rng.split("=")[1].split("-")[0])
                if start >= len(data):
                    self.send_response(416)
                    self.end_headers()
                    return
                self.send_response(206)
            else:
                self.send_response(200)
            self.send_header("Content-Length", str(len(data) - start))
            self.end_headers()
            self.wfile.write(data[start:])

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{server.server_address[1]}/voice.apk"
    md5 = hashlib.md5(good).hexdigest()
    try:
        with tempfile.TemporaryDirectory() as tmp:
            parent = os.path.join(tmp, "wowtype")
            folder = os.path.join(parent, "wtlocal")
            args = {"folder": folder, "url": url, "md5": md5, "size": len(good)}
            assert not voice_model_ready(folder)
            # 取消：什么也没装，.part 留着下次续
            try:
                install_voice_model(**args, cancelled=lambda: True)
                raise AssertionError("取消应该报 DownloadCancelled")
            except DownloadCancelled:
                pass
            assert not voice_model_ready(folder) and os.listdir(parent) == ["wtlocal.apk.part"]
            # 接着下完、装上：只留 .xnet 和词表，不认包里的路径，包删掉
            seen = []
            assert install_voice_model(**args, progress=lambda d, t: seen.append(d)) > 0
            assert voice_model_ready(folder)
            assert sorted(os.listdir(folder)) == sorted(["encoder.xnet", "decoder.xnet",
                                                         "evil.xnet", VOICE_MODEL_DICT])
            assert os.listdir(parent) == ["wtlocal"] and sorted(os.listdir(tmp)) == ["wowtype"]
            assert seen and seen[-1] == len(good)
            # MD5 不对：报错，坏包删掉，装好的那份不动
            for bad_args in ({"md5": "0" * 32}, {"size": len(good) + 1}):
