def check_nnlm_file(path):
    """用核心的读取代码试着解析模型：读得出来返回字表大小，读不出来抛 ValueError。"""
    if not os.access(CHECK_TOOL, os.X_OK):
        raise ValueError("找不到 wowtype-check，没法检查模型（重装 WowType 可以修好）")
    try:
        done = subprocess.run([CHECK_TOOL, "--nnlm", path], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        raise ValueError(f"检查模型时出错：{e}") from e
    if done.returncode != 0:
        reason = (done.stderr.strip().splitlines() or ["格式不对"])[-1]
        raise ValueError(f"读不出这个模型（{reason}），可能是微信输入法改了模型格式")
    return int(done.stdout.strip() or 0)


def read_wetype_nnlm(src):
    """从微信输入法的安装包（.zip）、程序目录（.app）或模型文件本身读出模型；不是就抛 ValueError。"""
    import zipfile
    if os.path.isdir(src):
        for root, _dirs, files in os.walk(src):
            if NNLM_NAME in files:
                with open(os.path.join(root, NNLM_NAME), "rb") as f:
                    return f.read(NNLM_MAX_BYTES)
        raise ValueError(f"这个目录里没有 {NNLM_NAME}")
    if zipfile.is_zipfile(src):
        with zipfile.ZipFile(src) as z:
            hits = [i for i in z.infolist()
                    if i.filename == NNLM_NAME or i.filename.endswith("/" + NNLM_NAME)]
            if not hits:
                raise ValueError(f"这个安装包里没有 {NNLM_NAME}，要微信输入法 macOS 版的安装包（.zip）")
            if hits[0].file_size > NNLM_MAX_BYTES:
                raise ValueError("包里的模型文件大得不对，不装")
            return z.read(hits[0])
    if os.path.getsize(src) > NNLM_MAX_BYTES:
        raise ValueError("这不是微信输入法的安装包（.zip），也不是模型文件")
    with open(src, "rb") as f:
        return f.read()


def install_wetype_nnlm(src, dest=None, check=None):
    """导入神经语言模型，返回字节数。先写到临时文件试着解析，解析不了抛 ValueError，不装。"""
    dest = dest or NNLM_FILE
    check = check or check_nnlm_file
    data = read_wetype_nnlm(src)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    try:
        check(tmp)
    except BaseException:
        os.remove(tmp)
        raise
    os.replace(tmp, dest)
    return len(data)


