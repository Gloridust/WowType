    # 页面上只放标题和最多一行的副标题。说明、注意事项、例子、来源、许可这类放进 ⓘ：
    #   组：group.set_header_suffix(self.info_button("…", [("项目主页", url)]))，ⓘ 在组标题右边
    #   行：self.add_info(row, "…")，ⓘ 在开关、下拉框前面（ActionRow、SwitchRow、ComboRow、ExpanderRow 都行）
    # macOS 设置窗口对应的是 InfoButton 和各行的 info:（macos/Sources/App/SettingsView.swift）。

    def info_button(self, text, links=()):
        """ⓘ 小按钮，点开弹出说明；links 是 [(文字, 网址)…]，放在说明下面。

        说明文字是 button.info_label，要随状态变时改它。标签不设 selectable：弹出框一打开它就拿到焦点、
        整段被选中。"""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10,
                      margin_bottom=10, margin_start=12, margin_end=12)
        label = Gtk.Label(label=text, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR,
                          max_width_chars=36, xalign=0)
        box.append(label)
        for title, url in links:
            box.append(Gtk.LinkButton(uri=url, label=title, halign=Gtk.Align.START))
        button = Gtk.MenuButton(icon_name="help-about-symbolic", valign=Gtk.Align.CENTER,
                                tooltip_text="说明", popover=Gtk.Popover(child=box))
        button.add_css_class("flat")
        button.info_label = label
        return button

    def add_info(self, row, text, links=()):
        """给一行加 ⓘ，放在这一行自己的开关、下拉框前面。返回按钮。"""
        button = self.info_button(text, links)
        add_suffix(row, button)
        # SwitchRow 的开关、ComboRow 的下拉也在后缀那一排里，新加的排在最后：挪到最前面
        suffixes = button.get_parent()
        if hasattr(suffixes, "reorder_child_after"):
            suffixes.reorder_child_after(button, None)
        return button

    def refresh_status(self):
        """第一页「输入法」：fcitx5 在不在跑、认不认得 WowType、在不在输入法列表里；差哪一步，按钮就做哪一步
        （和 wowtype-config --setup 一样，见 setup_action）。"""
        def got_group(info):
            if info is None:
                show(None)
                return
            group, _layout, items = info
            if any(name == "wowtype" for name, _ in items):
                self.status_row.set_title("WowType 已在输入法列表里")
                self.status_row.set_subtitle("用 Ctrl+空格（或你设的快捷键）切换到 WowType")
                self.status_button.set_visible(False)
            else:
                self.status_row.set_title("WowType 还没加到输入法列表")
                self.status_row.set_subtitle(
                    GLib.markup_escape_text(f"加到「{group}」里就能切换过去用"))
                self.status_button.set_label("添加")
                self.status_button.set_visible(True)

        def show(known):
            im_active = im_config_active() if known is None and not own_im_framework() else None
            action = setup_action(known, im_active)
            self.setup_state = (action, im_active)
            if action == "add":
                self.fcitx.group_info(got_group)
                return
            if action == "restart":
                self.status_row.set_title("fcitx5 还没载入 WowType")
                subtitle = "刚装完要重启一次 fcitx5 才能用"
                label = "重启并添加"
            else:
                self.status_row.set_title("fcitx5 没在运行")
                subtitle = (f"输入法框架是「{im_active}」，一键切到 fcitx5（要注销重新登录）"
                            if action == "im-config" else "一键写好输入法列表，fcitx5 下次启动时生效")
                label = "一键设置"
            self.status_row.set_subtitle(GLib.markup_escape_text(subtitle))
            self.status_button.set_label(label)
            self.status_button.set_visible(True)

        self.fcitx.call("AvailableInputMethods", None, "(a(ssssssb))", lambda value: show(
            None if value is None else any(item[0] == "wowtype" for item in value.unpack()[0])))

    def on_add_to_group(self, _button):
        action, im_active = getattr(self, "setup_state", ("add", None))
        question = setup_question(action, im_active)
        if question:
            self.confirm("一键设置", question, "切换" if action == "im-config" else "重启并添加",
                         lambda: self.start_setup(action))
        else:
            self.start_setup(action)

    def start_setup(self, action):
        """一键设置（run_setup，要等 fcitx5 重启、跑 im-config，放到线程里）。"""
        self.status_button.set_sensitive(False)
        self.status_row.set_subtitle("正在设置…")
        first = fcitx_first_time()
        hint = framework_hint(True)

        def work():
            lines = []
            try:
                code = run_setup(action, True, first, lines.append, True, hint)
            except Exception as e:  # noqa: BLE001
                code = SETUP_FAILED
                lines.append(str(e))
            GLib.idle_add(self.setup_done, action, code, lines)
        threading.Thread(target=work, daemon=True).start()

    def setup_done(self, action, code, lines):
        self.status_button.set_sensitive(True)
        log(f"一键设置：{action}，结果 {code}")
        if code == SETUP_OK:
            self.toast("已添加，可以切换到 WowType 了")
        else:
            heading = {SETUP_RESTARTED: "fcitx5 已重启，WowType 已添加",
                       SETUP_RELOGIN: "注销并重新登录后就能用了",
                       SETUP_UNFINISHED: "还差一步"}.get(code, "没设置好")
            body = "\n".join(lines)
            if code == SETUP_RESTARTED:
                body += "\n" + RESTART_NOTE
            dialog = AlertDialog(heading=heading, body=body)
            dialog.add_response("ok", "好")
            dialog.present(self)
        self.refresh_status()
        self.refresh_restart_hint()
        self.refresh_shift_conflict()
        return GLib.SOURCE_REMOVE

    def confirm(self, heading, body, yes_label, on_yes, no_label="取消"):
        """问一句，点了 yes_label 才 on_yes()。"""
        dialog = AlertDialog(heading=heading, body=body)
        dialog.add_response("cancel", no_label)
        dialog.add_response("yes", yes_label)
        dialog.set_response_appearance("yes", ResponseAppearance.SUGGESTED)
        dialog.connect("response", lambda _d, response: response == "yes" and on_yes())
        dialog.present(self)
        return dialog

    def refresh_restart_hint(self):
        """正在跑的插件和装好的不是同一版（升级了还没重启输入法）时，第一页提示重启。"""
        bus = self.fcitx.bus
        if not bus:
            return

        def finished(bus, result):
            try:
                running = addon_version_from(bus.call_finish(result).unpack()[0])
            except GLib.Error as e:
                running = addon_version_from(None, dbus_error_name(e))
            needed = restart_needed(running)
            self.restart_hint_row.set_visible(needed)
            if needed:
                self.restart_hint_row.set_subtitle(GLib.markup_escape_text(
                    f"正在用的还是 {running or '旧版'}，装好的是 {current_version()}"))
        bus.call(*ADDON_BUS, "Version", None, GLib.VariantType("(s)"),
                 Gio.DBusCallFlags.NO_AUTO_START, 2000, None, finished)

    def on_restart_hint(self, _button):
        def restart():
            def done(ok):
                self.toast("输入法已重启" if ok else "重启失败，可以注销后重新登录")
                if ok:
                    self.restart_hint_row.set_visible(False)
                self.refresh_status()
                self.refresh_restart_hint()
            self.fcitx.restart(done)
        self.confirm("重启输入法？", "WowType 的新版要重启输入法才生效。" + RESTART_NOTE, "重启输入法", restart)

