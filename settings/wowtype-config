class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None
        self.add_main_option("page", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "打开时显示的页面：general、input、emoji、voice、translate、words、stats、update", "页面")

    def do_startup(self):
        Adw.Application.do_startup(self)
        # 仓库里自带的图标（开发和未安装时也能显示；装好后系统图标主题里也有）
        here = os.path.dirname(os.path.abspath(__file__))
        local_icons = os.path.normpath(os.path.join(here, "..", "icons"))
        if os.path.isdir(local_icons):
            Gtk.IconTheme.get_for_display(Gdk.Display.get_default()).add_search_path(local_icons)
        # 跟在英文后面的「、」「。」，Pango 会去找第一个有这个字的字体，常常找到蒙古文字体，
        # 标点画在格子正中间。在系统界面字体后面接上简体中文字体，让它先找到这些。
        self.font_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.font_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        settings = Gtk.Settings.get_default()
        settings.connect("notify::gtk-font-name", lambda *_: self.update_font_css())
        self.update_font_css()
        # 微信输入法风格的配色；主题、强调色在「常规 → 设置窗口」里改（SettingsTheme、SettingsAccent）
        self.style_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.style_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # 主题固定时盖过 ~/.config/gtk-4.0/gtk.css（USER 优先级）的颜色，见 FORCED_COLORS
        self.forced_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.forced_css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        values = read_config()[0]
        self.look = (values["SettingsTheme"], values["SettingsAccent"])
        manager = Adw.StyleManager.get_default()
        manager.connect("notify::dark", lambda *_: self.update_style_css())
        self.update_style_css()

    def update_font_css(self):
        name = Gtk.Settings.get_default().props.gtk_font_name or "Sans 11"
        family = Pango.FontDescription.from_string(name).get_family() or "Sans"
        families = [family] + [f for f in CJK_SC_FONTS if f != family]
        quoted = ", ".join('"' + f.replace('"', "") + '"' for f in families)
        css_load(self.font_css, f"window {{ font-family: {quoted}; }}")

    def set_look(self, theme, accent):
        """换设置窗口的主题、强调色（SettingsTheme、SettingsAccent 的值），马上生效。"""
        if (theme, accent) != self.look:
            self.look = (theme, accent)
            self.update_style_css()

    def update_style_css(self):
        theme, accent = self.look
        manager = Adw.StyleManager.get_default()
        scheme = {"Light": Adw.ColorScheme.FORCE_LIGHT, "Dark": Adw.ColorScheme.FORCE_DARK}.get(
            theme, Adw.ColorScheme.DEFAULT)
        if manager.get_color_scheme() != scheme:
            manager.set_color_scheme(scheme)  # 会再发 notify::dark，再进来一次
        # 底色和文字都跟着主题（theme_css），dark 只管旧版 libadwaita 上强调色当字用时的颜色。
        # niri 等非 GNOME 桌面不一定把 color-scheme 报给 GTK，但用户可能选了深色 GTK 主题：主题名里带 dark 也按深色走。
        if theme in ("Light", "Dark"):
            dark = theme == "Dark"
        else:
            settings = Gtk.Settings.get_default()
            theme_name = (settings.props.gtk_theme_name or "").lower() if settings else ""
            dark = manager.get_dark() or "dark" in theme_name
        css_load(self.style_css, theme_css(dark, accent))
        css_load(self.forced_css, forced_css(dark) if theme in ("Light", "Dark") else "")

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        self.page = options.get("page")
        self.activate()
        return 0

    def do_activate(self):
        Gtk.Window.set_default_icon_name("wowtype")
        window = self.props.active_window
        if not window:
            window = SettingsWindow(self, self.page)
        elif self.page:
            window.show_page(self.page)
        window.present()


