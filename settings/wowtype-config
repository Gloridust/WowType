    def make_switch(self, key, title, subtitle):
        row = Adw.SwitchRow(title=title, subtitle=subtitle)
        row.set_active(self.values[key] == "True")
        row.connect("notify::active", lambda r, _p: self.set_value(
            key, "True" if r.get_active() else "False"))
        self.switches[key] = row
        return row

    def refresh_status(self):
        def done(info):
            if info is None:
                self.status_row.set_title("没检测到 fcitx5")
                self.status_row.set_subtitle("先启动 fcitx5，设置会在它下次启动时生效")
                self.status_button.set_visible(False)
                self.group_info = None
                return
            group, layout, items = info
            self.group_info = info
            if any(name == "wowtype" for name, _ in items):
                self.status_row.set_title("WowType 已在输入法列表里")
                self.status_row.set_subtitle("用 Ctrl+空格（或你设的快捷键）切换到 WowType")
                self.status_button.set_visible(False)
            else:
                self.status_row.set_title("WowType 还没加到输入法列表")
                self.status_row.set_subtitle(
                    GLib.markup_escape_text(f"加到「{group}」里就能切换过去用"))
                self.status_button.set_visible(True)
        self.fcitx.group_info(done)

    def on_add_to_group(self, _button):
        if not self.group_info:
            return
        group, layout, items = self.group_info

        def done(ok):
            self.toast("已添加，可以切换到 WowType 了" if ok else "添加失败")
            self.refresh_status()
        self.fcitx.add_to_group(group, layout, items, done)

