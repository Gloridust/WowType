    def devlog_tick(self):
        if self.stack.get_visible_child_name() == "general":
            self.refresh_devlog()
        return True

    def refresh_devlog(self):
        """「打字记录」那一行：有多少条、多大；没有记录时导出和清空点不了。"""
        count, size = devlog_summary()
        on = self.values.get("DeveloperMode") == "True"
        if count:
            text = f"{count} 条，{devlog_size(size)}，在 {_home(DEVLOG_FILE)}"
            if not on:
                text += "（开发者模式关着，不再记新的）"
        else:
            text = "还没有记录" if on else "开发者模式关着，什么都不记"
        self.devlog_row.set_subtitle(GLib.markup_escape_text(text))
        self.devlog_export.set_sensitive(count > 0)
        self.devlog_clear.set_sensitive(bool(devlog_files()))

    def on_developer_mode(self, row, _param):
        if self.quiet_switch:
            return
        if not row.get_active():
            self.set_value("DeveloperMode", "False")
            self.refresh_devlog()
            return
        if self.values.get("DeveloperMode") == "True":
            return
        # 先拨回去：点了「打开」才真的打开
        self.set_developer_switch(False)
        self.devmode_dialog = self.confirm("打开开发者模式？", DEVLOG_WARNING, "打开，开始记录",
                                           self.developer_mode_confirmed)

    def set_developer_switch(self, on):
        self.quiet_switch = True
        self.devmode_row.set_active(on)
        self.quiet_switch = False

    def developer_mode_confirmed(self):
        self.set_developer_switch(True)
        self.set_value("DeveloperMode", "True")
        self.refresh_devlog()

