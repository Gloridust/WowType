CLASSICUI_URI = "fcitx://config/addon/classicui"
THEME_LIGHT = "wowtype"
THEME_DARK = "wowtype-dark"
GNOME_THEME_EXT = "wowtype-theme@gloridust.github.io"
KIMPANEL_EXT = "kimpanel@kde.org"


def gnome_shell_settings():
    """GNOME Shell 的 gsettings（不是 GNOME 返回 None）。"""
    if "GNOME" not in os.environ.get("XDG_CURRENT_DESKTOP", "").upper():
        return None
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup("org.gnome.shell", True) is None:
        return None
    return Gio.Settings.new("org.gnome.shell")


def gnome_extension_info(uuid):
    """GNOME Shell 里这个扩展的信息；这次登录没扫到（新装的扩展要重新登录）时是空字典。

    注意接口在 org.gnome.Shell 上；org.gnome.Shell.Extensions 那个名字是「扩展」应用，
    不自动启动时根本不存在。
    """
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        value = bus.call_sync("org.gnome.Shell", "/org/gnome/Shell",
                              "org.gnome.Shell.Extensions", "GetExtensionInfo",
                              GLib.Variant("(s)", (uuid,)), GLib.VariantType("(a{sv})"),
                              Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        return value.unpack()[0]
    except GLib.Error:
        return {}


def gnome_extension_loaded(uuid):
    """GNOME Shell 这次登录有没有扫到这个扩展。"""
    return bool(gnome_extension_info(uuid))


def set_gnome_extension(settings, uuid, enabled):
    """在 enabled-extensions 里加上/去掉；GNOME Shell 盯着这个键，扫到了的扩展马上生效。"""
    on = [u for u in settings.get_strv("enabled-extensions") if u != uuid]
    off = [u for u in settings.get_strv("disabled-extensions") if u != uuid]
    (on if enabled else off).append(uuid)
    settings.set_strv("enabled-extensions", on)
    settings.set_strv("disabled-extensions", off)


def fcitx_call_sync(method, params=None, reply=None):
    """同步调 fcitx5（命令行和后台任务用）；fcitx5 没在跑时返回 None。"""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return bus.call_sync(Fcitx.NAME, Fcitx.PATH, Fcitx.IFACE, method, params,
                             GLib.VariantType(reply) if reply else None,
                             Gio.DBusCallFlags.NO_AUTO_START, 3000, None)
    except GLib.Error:
        return None


PROFILE_FILE = os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), "fcitx5", "profile")


def fcitx_knows_wowtype():
    """fcitx5 在跑并且认得 WowType 返回 True，在跑但不认得（装完还没重启）False，没在跑 None。"""
    value = fcitx_call_sync("AvailableInputMethods", None, "(a(ssssssb))")
    if value is None:
        return None
    return any(item[0] == "wowtype" for item in value.unpack()[0])


def system_keyboard_layout():
    """fcitx5 键盘布局的名字（us、de-nodeadkeys……），从 localectl 读，读不到用 us。"""
    layout = variant = ""
    try:
        out = subprocess.run(["localectl", "status"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    for line in out.splitlines():
        key, _, value = line.strip().partition(":")
        value = value.strip().split(",")[0].strip()
        if key == "X11 Layout":
            layout = value
        elif key == "X11 Variant":
            variant = value
    layout = layout or "us"
    return f"{layout}-{variant}" if variant else layout


def profile_add_wowtype(path=PROFILE_FILE):
    """fcitx5 没在跑时直接改它的配置文件 profile，把 WowType 加进第一个分组。

    没有 profile（fcitx5 还没运行过）就新建一个：系统键盘布局 + WowType。
    fcitx5 退出时会把内存里的分组写回 profile，所以只能在它没在跑时改。返回说明文字。
    """
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        layout = system_keyboard_layout()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"[Groups/0]\nName=Default\nDefault Layout={layout}\nDefaultIM=wowtype\n\n"
                    f"[Groups/0/Items/0]\nName=keyboard-{layout}\nLayout=\n\n"
                    "[Groups/0/Items/1]\nName=wowtype\nLayout=\n\n"
                    "[GroupOrder]\n0=Default\n")
        return f"新建了 fcitx5 输入法列表：键盘 {layout} + WowType"
    sections, current = {}, None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1]
            sections.setdefault(current, {})
        elif current and "=" in line and not line.startswith("#"):
            key, _, value = line.partition("=")
            sections[current][key.strip()] = value.strip()
    first = sections.get("GroupOrder", {}).get("0")
    index = next((name.split("/")[1] for name, keys in sections.items()
                  if re.fullmatch(r"Groups/\d+", name) and keys.get("Name") == first), None)
    if index is None:
        raise RuntimeError(f"看不懂 {path}，请在 fcitx5 配置里手动添加 WowType")
    items = [keys.get("Name") for name, keys in sections.items()
             if re.fullmatch(rf"Groups/{index}/Items/\d+", name)]
    if "wowtype" in items:
        return f"WowType 已经在输入法列表「{first}」里"
    with open(path + ".bak-wowtype", "w", encoding="utf-8") as f:
        f.write(text)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text.rstrip("\n") + f"\n\n[Groups/{index}/Items/{len(items)}]\nName=wowtype\nLayout=\n")
    return f"已把 WowType 加进输入法列表「{first}」（原来的存成 profile.bak-wowtype）"


def add_to_group_cli(restart):
    """安装脚本用（wowtype-config --add-to-group [--restart]）：把 WowType 加进当前输入法分组。

    fcitx5 在跑：认得 WowType 就经 D-Bus 加；不认得（刚装完）时带 --restart 先让它重启，
    否则返回 3。fcitx5 没在跑：直接改 profile。成功（含本来就在）返回 0。
    """
    known = fcitx_knows_wowtype()
    if known is None:
        print(profile_add_wowtype())
        return 0
    if not known:
        if not restart:
            print("fcitx5 还没载入 WowType，要先重启 fcitx5")
            return 3
        fcitx_call_sync("Restart")
        for _ in range(60):  # 最多等 15 秒
            time.sleep(0.25)
            known = fcitx_knows_wowtype()
            if known:
                break
        if not known:
            print("重启 fcitx5 以后还是找不到 WowType，请注销重新登录后在 fcitx5 配置里添加")
            return 1
        print("已重启 fcitx5")
    group = fcitx_call_sync("CurrentInputMethodGroup", None, "(s)").unpack()[0]
    info = fcitx_call_sync("InputMethodGroupInfo", GLib.Variant("(s)", (group,)), "(sa(ss))")
    layout, items = info.unpack()
    if any(name == "wowtype" for name, _ in items):
        print(f"WowType 已经在输入法列表「{group}」里")
        return 0
    items = list(items) + [("wowtype", "")]
    if fcitx_call_sync("SetInputMethodGroupInfo",
                       GLib.Variant("(ssa(ss))", (group, layout, items))) is None:
        print("添加失败，请在 fcitx5 配置里手动添加 WowType")
        return 1
    print(f"已把 WowType 加进输入法列表「{group}」")
    return 0


def classicui_theme_values(on):
    # fcitx5 经典界面（KDE、X11 等）：浅色/深色各一套，跟随系统深浅色
    if on:
        return {"Theme": THEME_LIGHT, "DarkTheme": THEME_DARK, "UseDarkTheme": "True"}
    return {"Theme": "default", "DarkTheme": "default-dark"}


def apply_gnome_theme(on):
    """GNOME 上候选框是 Input Method Panel（kimpanel）扩展画的，换色靠另一个小扩展。

    返回给用户看的一句话；不是 GNOME 时返回 None。
    """
    shell = gnome_shell_settings()
    if shell is None:
        return None
    set_gnome_extension(shell, GNOME_THEME_EXT, on)
    if not on:
        return "已换回默认配色"
    if KIMPANEL_EXT not in shell.get_strv("enabled-extensions"):
        return "GNOME 上要先装并启用 Input Method Panel 扩展，候选框才会用这个主题"
    if not gnome_extension_loaded(GNOME_THEME_EXT):
        return "注销并重新登录一次后生效（GNOME 新装的扩展要重新登录才加载）"
    return "已换成 WowType 主题"


def init_default_theme():
    """第一次用 WowType 时把绿色主题打开（只做一次，之后听用户的）。

    不覆盖用户自己选的别的 fcitx5 主题；GNOME 上用户关过这个扩展的也不动。
    fcitx5 还没起来时什么都不做，下次再试。
    """
    if read_state().get("theme_default_done"):
        return
    value = fcitx_call_sync("GetConfig", GLib.Variant("(s)", (CLASSICUI_URI,)),
                            "(va(sa(sssva{sv})))")
    if value is None:
        return
    shell = gnome_shell_settings()
    if shell is not None and GNOME_THEME_EXT in shell.get_strv("disabled-extensions"):
        update_state(theme_default_done=True)
        log("默认主题：用户在 GNOME 里关过 WowType 主题，不动")
        return
    current = value.unpack()[0].get("Theme", "default")
    if current in ("default", "", THEME_LIGHT):
        raw = GLib.Variant("a{sv}", {k: GLib.Variant("s", v)
                                     for k, v in classicui_theme_values(True).items()})
        fcitx_call_sync("SetConfig", GLib.Variant("(sv)", (CLASSICUI_URI, raw)))
        log(f"默认主题：fcitx5 经典界面 {current or 'default'} -> {THEME_LIGHT}")
    else:
        log(f"默认主题：用户在用别的主题 {current}，不动")
    if shell is not None:
        log(f"默认主题：GNOME 扩展 {apply_gnome_theme(True)}")
    update_state(theme_default_done=True)


def startup_tasks():
    """插件每次 fcitx5 运行里第一次切到 WowType 时在后台叫（wowtype-config --startup）。"""
    try:
        init_default_theme()
    except Exception as e:  # 主题弄不好也别耽误检查更新
        log(f"默认主题失败：{e!r}")
    return background_check()


