    def refresh_translate_status(self):
        """「翻译」页互译那一行的副标题（怎么进「译」），连带「输入」页两个快捷键行的提示。"""
        if not hasattr(self, "test_row"):
            return
        self.refresh_key_hints()
        conflicts = getattr(self, "shift_conflicts", [])
        toggle = self.values.get("ShiftToggle", "Both")
        usable = [SHIFT_NAMES[s] for s in SHIFT_SIDES.get(toggle, ())
                  if s not in {bare_shift(k) for _o, k in conflicts}]
        key = self.translate_mode_key()
        held = self.values.get("TranslateModeKey", "") if not key else ""
        if not self.translate_ready():
            self.translate_row.set_subtitle(
                "先在下面下载翻译模型" if self.values.get("TranslateLocal") == "True"
                else "先在下面填好翻译服务")
        elif key:
            self.translate_row.set_subtitle(f"按 {key_label(key)} 进出「译」" + (
                "，双击 Shift 也行" if self.values.get("TranslateOneShot") == "True" and toggle != "Off" else ""))
        elif held:
            # 设了互译键，单按 Shift 就不进「译」了；键又被 fcitx5 拿走，哪个都进不去
            self.translate_row.set_subtitle(f"互译的快捷键 {key_label(held)} 被 fcitx5 占着，先在 Fcitx 5 配置里删掉它")
        elif toggle == "Off":
            self.translate_row.set_subtitle("「输入」页关掉了 Shift 切换，切不到「译」；可以在那里设一个互译的快捷键")
        elif conflicts:
            taken = shift_side_names(conflicts)
            self.translate_row.set_subtitle(
                f"{taken} 被 fcitx5 占着；" + (f"用{'、'.join(usable)}，" if usable else "")
                + "或到「输入」页让给 WowType")
        elif self.values.get("TranslateOneShot") == "True":
            self.translate_row.set_subtitle("双击 Shift 翻一句，单按只切中英")
        else:
            self.translate_row.set_subtitle("单按 Shift：中 → 英 → 译 → 中")

    def on_test_translate(self, _button):
        if self.translate_engine_selected() == 1:
            # 哔哩哔哩：不带 Key（test_translate 也会去掉）
            base, key = BILIBILI_URL, ""
            model = self.bili_ids[self.bili_model_row.get_selected()]
            row, button = self.bili_test_row, self.bili_test_button
        else:
            base = self.url_row.get_text().strip()
            model = self.tmodel_row.get_text().strip()
            key = self.key_entry.get_text().strip()
            row, button = self.test_row, self.test_button
        if not base or not model:
            row.set_subtitle("先填接口地址和模型")
            return
        target = self.target_codes[self.target_row.get_selected()]
        formal = self.values.get("TranslateFormal") == "True"
        button.set_sensitive(False)
        row.set_subtitle("正在连接…")

        def work():
            try:
                text, seconds = test_translate(base, key, model, target, formal=formal)
                result = (text, seconds, None)
            except TranslateError as e:
                result = (None, 0, str(e))
            GLib.idle_add(self.test_finished, row, button, *result)
        threading.Thread(target=work, daemon=True).start()

    def test_finished(self, row, button, text, seconds, error):
        button.set_sensitive(True)
        if error:
            row.set_subtitle(GLib.markup_escape_text(f"✗ {error}"))
            log(f"测试翻译服务失败：{error}")
            return
        message = f"✓ 你好 → {text}（{seconds:.1f} 秒）"
        if seconds > 2.5:
            message += "，有点慢，可以换个小一点的模型"
        row.set_subtitle(GLib.markup_escape_text(message))
        log(f"测试翻译服务成功（{seconds:.1f} 秒）")

