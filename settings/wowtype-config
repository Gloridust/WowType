# 以后发布的 words.lm 带标记，这张表不用再加
OFFICIAL_LM_SIZES = {38455852: "2026.11.09"}  # lm-2026.11.09


def stale_bundled_copy(user, system):
    """用户目录里的这份是不是安装包自带数据的旧副本，插件会改用系统目录里安装包带的那份。

    和插件的 isStaleBundledCopy（fcitx5-addon/src/data_files.h）同一套规则，系统目录里也要有一份：
    - 用户目录这份带版本标记、名字和文件名一样：版本不比系统目录那份新就是旧副本；比它新（自己下了新数据），
      或者系统目录那份看不出版本（老安装包），用用户目录的。名字不一样（别的词库）也用用户目录的。
    - 没有标记（加标记以前发布的数据、或者自己做的）：第一行是 WowType 生成的标准数据，而且不比系统目录的新
      （系统目录的时间戳早于 2000 年时看不出新旧，也算）；words.lm 看字节数是不是某一版官方发布的。
    0.3.4 以前 README 让大家把词库拷进用户目录，后来安装包自带了，那份却一直优先。"""
    name = os.path.basename(user)
    if not os.path.isfile(system):
        return False
    try:
        if os.path.samefile(user, system):
            return False
    except OSError:
        return False
    marker = read_data_marker(user)
    if marker:
        if marker[0] != name:
            return False
        found = data_file_version(system, name)
        return bool(found) and compare_data_versions(marker[1], found[0]) <= 0
    legacy = BUNDLED_DATA_MARKERS.get(name)
    if not (legacy or name == "words.lm"):
        return False
    try:
        if name == "words.lm":
            return os.path.getsize(user) in OFFICIAL_LM_SIZES
        with open(user, "rb") as f:
            first = f.readline().decode("utf-8", "replace")
        if not first.startswith(legacy):
            return False
        user_mtime = os.stat(user).st_mtime
        system_mtime = os.stat(system).st_mtime
    except OSError:
        return False
    return system_mtime < 946684800 or user_mtime <= system_mtime


def without_stale_copy(candidates):
    """插件找数据文件的顺序（环境变量、用户目录、系统目录），去掉用户目录里的旧副本。"""
    out = []
    for path in candidates:
        if path and path.startswith(DATA_DIR + os.sep) and os.path.isfile(path):
            system = os.path.join(SYSTEM_DATA_DIR, os.path.relpath(path, DATA_DIR))
            if stale_bundled_copy(path, system):
                continue
        out.append(path)
    return out


def lexicon_in_use_candidates():
    """插件找默认词库的顺序，去掉用户目录里的旧副本。"""
    return without_stale_copy(LEXICON_CANDIDATES)


