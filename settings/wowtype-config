def sync_devices(path=None):
    """配对文件里记着的：（配没配对, 一起配过对的设备的名字）。不读、不显示组密钥。"""
    try:
        with open(path or SYNC_STATE_FILE, encoding="utf-8") as f:
            state = json.load(f)
        names = [str(d.get("name") or "没起名字的设备") for d in state.get("devices", [])]
        return bool(state.get("group_key")), names
    except (OSError, ValueError, AttributeError):
        return False, []


def sync_command(command, values, *more):
    """wowtype-sync 的命令行：照设置带上配对文件、设备名、局域网开没开、中转服务。口令只给文件名。"""
    args = [sync_tool(), command, *more, "--state", SYNC_STATE_FILE,
            "--name", values.get("ClipboardSyncDeviceName", "").strip() or os.uname().nodename]
    if values.get("ClipboardSyncLan", "True") != "True":
        args.append("--no-lan")
    relay = values.get("ClipboardSyncRelayUrl", "").strip()
    if relay:
        args += ["--relay", relay, "--relay-key-file", SYNC_RELAY_KEY_FILE]
    # 测试、排查用：加入时不靠广播找，直接连这个 地址:端口（广播被防火墙挡了的时候）
    host = os.environ.get("WOWTYPE_SYNC_PAIR_HOST")
    if command == "pair-join" and host:
        args += ["--host", host]
    return args


def sync_result(output):
    """wowtype-sync 最后一行：paired 名字 / ok → (True, 名字)；error 说明 → (False, 说明)。"""
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    last = lines[-1] if lines else ""
    word, _, rest = last.partition(" ")
    if word in ("paired", "ok"):
        return True, rest
    return False, rest if word == "error" and rest else "配对工具没有回话"


