class _AlertDialog:
    """Adw.AlertDialog（1.5）换成 Gtk.MessageDialog；response 信号给回答的 id，关掉窗口算取消。"""

    def __init__(self, heading="", body=""):
        self.heading, self.body = heading, body
        self.responses, self.styles, self.handlers = [], {}, []
        self.dialog = None

    def add_response(self, response_id, label):
        self.responses.append((response_id, label))

    def set_response_appearance(self, response_id, appearance):
        self.styles[response_id] = appearance

    def connect(self, signal, handler):
        assert signal == "response", signal
        self.handlers.append(handler)

    def present(self, parent):
        dialog = Gtk.MessageDialog(transient_for=parent, modal=True, text=self.heading,
                                   secondary_text=self.body)
        for index, (response_id, label) in enumerate(self.responses):
            button = dialog.add_button(label, index)
            if response_id in self.styles:
                button.add_css_class(self.styles[response_id])

        def answered(dialog, index):
            dialog.destroy()
            ok = 0 <= index < len(self.responses)
            answer = self.responses[index][0] if ok else "cancel"
            for handler in self.handlers:
                handler(self, answer)
        dialog.connect("response", answered)
        self.dialog = dialog
        dialog.present()

    def close(self):
        """跟 Adw.Dialog.close 一样：关掉算取消。"""
        dialog, self.dialog = self.dialog, None
        if dialog is not None:
            dialog.response(Gtk.ResponseType.DELETE_EVENT)


