    def refresh_sync(self, note=None):
        """照现在的状态改「配对」那一行。note：正在显示的配对码之类，盖过平常的说明。"""
        if not hasattr(self, "sync_pair_row"):
            return
        tool = sync_tool()
        paired, names = sync_devices()
        hosting = self.sync_host is not None
        if note:
            text = note
        elif not tool:
            text = "这个安装包里没有配对工具（wowtype-sync），更新 WowType 以后再试"
        elif paired and names:
            text = "已经和 " + "、".join(names) + " 配对"
        elif paired:
            text = "已经配对"
        else:
            text = "还没有配对：在一台设备上显示配对码，在另一台上输入"
        self.sync_pair_row.set_subtitle(GLib.markup_escape_text(text))
        self.sync_host_button.set_label("取消" if hosting else "显示配对码")
        self.sync_host_button.set_sensitive(bool(tool) and not self.sync_busy)
        self.sync_unpair_button.set_visible(paired and not hosting)
        self.sync_code_row.set_sensitive(bool(tool) and not hosting and not self.sync_busy)
        self.sync_ping_button.set_sensitive(bool(tool) and not self.sync_busy)

    def on_sync_token_changed(self, _row):
        if self.sync_token_source:
            GLib.source_remove(self.sync_token_source)
        self.sync_token_source = GLib.timeout_add(400, self.save_sync_token)

    def save_sync_token(self):
        self.sync_token_source = 0
        try:
            write_translate_key(self.sync_token_row.get_text(), SYNC_RELAY_KEY_FILE)
        except OSError as e:
            self.toast(f"访问口令保存失败：{e.strerror}")
        else:
            # 插件每次重新配置时读口令文件
            self.fcitx.reload()
        return GLib.SOURCE_REMOVE

    def sync_flush(self):
        """跑 wowtype-sync 之前：没存的访问口令先存上（它从文件里读）。"""
        if self.sync_token_source:
            GLib.source_remove(self.sync_token_source)
            self.save_sync_token()

    def on_sync_host(self, _button):
        """「显示配对码」：起 wowtype-sync pair-host，它先打一行配对码，配上了再打一行结果。"""
        if self.sync_host is not None:
            # 「取消」：结束进程，读输出的线程会收尾
            self.sync_host.terminate()
            return
        self.sync_flush()
        try:
            process = subprocess.Popen(sync_command("pair-host", self.values), stdout=subprocess.PIPE,
                                       stderr=subprocess.DEVNULL, text=True, encoding="utf-8")
        except OSError as e:
            self.toast(f"配对工具起不来：{e.strerror}")
            return
        self.sync_host = process
        self.refresh_sync("正在准备配对码…")
        log("跨设备复制粘贴：开始配对（显示配对码）")

        def work():
            output = []
            for line in process.stdout:
                output.append(line)
                word, _, rest = line.strip().partition(" ")
                if word == "code":
                    code = rest.split()[0]
                    self.sync_host_info = (code, (rest.split() + [""] * 3)[2])
                    GLib.idle_add(self.refresh_sync,
                                  f"配对码 {code[:3]} {code[3:]}：在另一台设备的 WowType 设置里输入，5 分钟内有效")
            process.wait()
            GLib.idle_add(self.sync_host_done, process, "".join(output))
        threading.Thread(target=work, daemon=True).start()

    def sync_host_done(self, process, output):
        if self.sync_host is process:
            self.sync_host = None
            self.sync_host_info = None
        ok, text = sync_result(output)
        if ok:
            log("跨设备复制粘贴：配对成功")
            self.toast(f"已经和 {text} 配对")
            self.fcitx.reload()
        elif process.returncode is not None and process.returncode < 0:
            log("跨设备复制粘贴：取消了配对")
        else:
            log(f"跨设备复制粘贴：没配上：{text}")
            self.toast(text)
        self.refresh_sync()

    def sync_run(self, args, done):
        """后台跑一条 wowtype-sync，跑完在主线程调 done(成没成, 说明)。"""
        self.sync_flush()
        self.sync_busy = True
        self.refresh_sync()

        def work():
            try:
                result = subprocess.run(args, capture_output=True, text=True, encoding="utf-8",
                                        timeout=90)
                outcome = sync_result(result.stdout)
            except subprocess.TimeoutExpired:
                outcome = (False, "等太久了，没有结果")
            except OSError as e:
                outcome = (False, f"配对工具起不来：{e.strerror}")

            def finish():
                self.sync_busy = False
                done(*outcome)
