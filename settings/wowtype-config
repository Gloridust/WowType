    def refresh_theme(self):
        def done(config):
            if config is None:
                self.theme_row.set_subtitle("没检测到 fcitx5，启动 fcitx5 后再来设置")
                return
            active = config.get("Theme") == THEME_LIGHT
            shell = gnome_shell_settings()
            if shell is not None:
                active = active or GNOME_THEME_EXT in shell.get_strv("enabled-extensions")
            self.theme_row.handler_block(self.theme_handler)
            self.theme_row.set_active(active)
            self.theme_row.handler_unblock(self.theme_handler)
            self.theme_row.set_sensitive(True)
        self.fcitx.get_config(CLASSICUI_URI, done)

    def on_theme_toggled(self, row, _param):
        on = row.get_active()
        # fcitx5 经典界面（KDE、X11 等）：浅色/深色各一套，跟随系统深浅色
        if on:
            values = {"Theme": THEME_LIGHT, "DarkTheme": THEME_DARK, "UseDarkTheme": "True"}
        else:
            values = {"Theme": "default", "DarkTheme": "default-dark"}
        self.fcitx.set_config(CLASSICUI_URI, values)

        # GNOME 上候选框是 Input Method Panel（kimpanel）扩展画的，换色靠另一个小扩展
        shell = gnome_shell_settings()
        if shell is None:
            self.toast("已换成 WowType 主题" if on else "已换回 fcitx5 默认主题")
            return
        set_gnome_extension(shell, GNOME_THEME_EXT, on)
        if not on:
            self.toast("已换回默认配色")
        elif KIMPANEL_EXT not in shell.get_strv("enabled-extensions"):
            self.toast("GNOME 上要先装并启用 Input Method Panel 扩展，候选框才会用这个主题")
        elif not gnome_extension_loaded(GNOME_THEME_EXT):
            self.toast("注销并重新登录一次后生效（GNOME 新装的扩展要重新登录才加载）")
        else:
            self.toast("已换成 WowType 主题")

