        self.llama_row.connect("changed", lambda row: (
            self.set_value("TranslateLlamaServer", row.get_text().strip()),
            self.refresh_local_translate()))
        more.add_row(self.llama_row)
        group.add(more)
        return group

    def local_ready(self):
        return os.path.isfile(local_model_path(self.values)) and bool(
            find_llama_server(self.values["TranslateLlamaServer"]))

    def local_missing(self, upgrade=False):
        """还差什么没下载：（要不要模型, 要不要 llama-server, 一共多少字节）。

        llama-server 只在系统里没有、这台机器又有现成的官方包时才算。upgrade：还在用上一代模型时
        把新模型也算进去（点「升级」时）。"""
        want_model = not os.path.isfile(local_model_path(self.values)) or (
            upgrade and bool(legacy_model_path(self.values)))
        asset = llama_asset()
        want_llama = bool(asset) and not find_llama_server(self.values["TranslateLlamaServer"])
        size = (LOCAL_MODEL_SIZE if want_model else 0) + (asset[1] if want_llama else 0)
        return want_model, want_llama, size

    def refresh_local_translate(self):
        if not hasattr(self, "local_group"):
            return
        engine = self.translate_engine_selected()
        local = engine == 0
        self.engine_row.set_subtitle(TRANSLATE_ENGINES[engine][1])
        self.local_group.set_visible(local)
        self.bili_group.set_visible(engine == 1)
        self.service_group.set_visible(engine == 2)
        path = local_model_path(self.values)
        downloading = self.local_cancel is not None
        server = find_llama_server(self.values["TranslateLlamaServer"])
        mine = downloaded_llama_server()
        want_model, want_llama, size = self.local_missing()
        # 还在用上一代模型：能用，另给「升级」
        legacy = bool(legacy_model_path(self.values))
        if downloading:
            pass  # 进度由下载线程更新
        elif not want_model and server and legacy:
            self.local_model_row.set_subtitle(GLib.markup_escape_text(
                f"在用上一代的 {LEGACY_MODEL_NAME}（{human_size(os.path.getsize(path))}），"
                f"可以升级到 Hy-MT3（{human_size(LOCAL_MODEL_SIZE)}）"))
        elif not want_model and server:
            self.local_model_row.set_subtitle(GLib.markup_escape_text(
                f"已下载（{human_size(os.path.getsize(path))}）"))
        elif not want_model and want_llama:
            self.local_model_row.set_subtitle(GLib.markup_escape_text(
                f"还差运行模型的程序（{human_size(size)}）"))
        elif not want_model:
            self.local_model_row.set_subtitle("还差 llama.cpp，见「更多选项」")
        else:
            self.local_model_row.set_subtitle(GLib.markup_escape_text(f"要下载 {human_size(size)}"))
        upgrade = legacy and not want_model and not want_llama
        self.local_download.set_label("取消" if downloading else "升级" if upgrade else "下载")
        self.local_download.set_visible(downloading or want_model or want_llama or legacy)
        self.local_delete.set_visible(
            not downloading and not self.values["TranslateLocalModel"]
            and (os.path.isfile(path) or bool(mine)))
        if server and server == mine:
            self.llama_status.set_subtitle(GLib.markup_escape_text(
                f"已下载 llama.cpp {LLAMA_BUILD}：{_home(server)}"))
        elif server:
            self.llama_status.set_subtitle(GLib.markup_escape_text(f"用系统里装的：{server}"))
        elif llama_asset():
            self.llama_status.set_subtitle("下载模型时一起下载")
        else:
            self.llama_status.set_subtitle(
                "没找到，请装发行版的 llama.cpp（NixOS：pkgs.llama-cpp）或在下面填位置")
        self.refresh_translate_status()

    def on_local_download(self, _button):
        if self.local_cancel is not None:
            self.local_cancel.set()
            return
        # 模型能用、只差 llama-server 时先把它补上；都齐了、还在用上一代模型，点的就是「升级」
        want_model, want_llama, size = self.local_missing()
        upgrade = not want_model and not want_llama and bool(legacy_model_path(self.values))
        if upgrade:
            want_model, want_llama, size = self.local_missing(upgrade=True)
        if not want_model or os.path.exists(local_model_dest(self.values) + ".part"):
            # 只差 llama-server，或者模型下到一半（开始下时已经确认过）：不用再确认，接着下（和 macOS 一样）
            self.start_local_download(upgrade)
            return
        extra = ("同时下载运行模型的程序 llama-server（llama.cpp 官方发布，MIT 许可）。"
                 if want_llama else "")
        if upgrade:
            extra = f"下好以后删掉上一代的 {LEGACY_MODEL_NAME}，下载期间照旧用它翻译。"
        dialog = AlertDialog(
            heading="升级离线翻译模型？" if upgrade else "下载离线翻译模型？",
            body=f"一共 {human_size(size)}，下载完会校验文件。{extra}\n\n{LOCAL_MODEL_TERMS}")
        dialog.add_response("cancel", "取消")
        dialog.add_response("accept", "升级" if upgrade else "下载")
        dialog.set_response_appearance("accept", ResponseAppearance.SUGGESTED)

        def answered(_dialog, response):
            if response == "accept":
                self.start_local_download(upgrade)
        dialog.connect("response", answered)
        dialog.present(self)

    def start_local_download(self, upgrade=False):
        """把还差的都下了：模型，和系统里没有时的 llama-server。进度都显示在「翻译模型」那一行。

        模型下到现在用的位置：设置里写了 TranslateLocalModel 就下到那里，没写下到 models/（和 macOS 一样），
        下完就能用，不会出现下好了却还显示缺模型。upgrade：还在用上一代模型，把新的下到 models/，
        校验过了再删旧的。"""
        dest = local_model_dest(self.values)
        want_model, want_llama, _size = self.local_missing(upgrade)
        if self.local_cancel is not None or not (want_model or want_llama):
            return
        default_place = not self.values["TranslateLocalModel"]
        cancel = threading.Event()
        self.local_cancel = cancel
        self.local_model_row.set_subtitle("正在连接…")
        self.refresh_local_translate()
        log("开始下载：" + "、".join(
            name for name, want in (("本地翻译模型", want_model), ("llama-server", want_llama)) if want))

        def progress_of(what):
            def progress(done, total):
                text = (f"正在下载{what}：{human_size(done)} / {human_size(total)}（{done * 100 // total}%）"
                        if total else f"正在下载{what}：{human_size(done)}")
                GLib.idle_add(self.local_model_row.set_subtitle, text)
            return progress

        def work():
            error = None
            try:
                if want_model:
                    download_model(dest, progress=progress_of("模型"), cancelled=cancel.is_set)
                    if default_place:
                        remove_legacy_model()
                if want_llama:
                    install_llama_server(progress=progress_of("运行程序"), cancelled=cancel.is_set)
            except DownloadCancelled:
                error = "已暂停，再点下载会接着下"
            except ValueError as e:
                error = str(e)
            except OSError as e:
                error = f"下载失败：{getattr(e, 'reason', None) or e}"
            GLib.idle_add(self.local_download_done, error)
        threading.Thread(target=work, daemon=True).start()

    def local_download_done(self, error):
        self.local_cancel = None
        if error:
            log(f"本地翻译没下完：{error}")
            self.toast(error)
        else:
            log("本地翻译下载完成，校验通过")
            self.toast("下载好了，可以用离线翻译了" if self.local_ready() else "模型下载好了")
        self.fcitx.reload()
        self.refresh_local_translate()

    def on_local_delete(self, _button):
        """删掉下载的模型和 WowType 自己下载的 llama-server（系统里装的不动）。"""
        path = local_model_path(self.values)
        freed = os.path.getsize(path) if os.path.isfile(path) else 0
        try:
            if freed:
                os.unlink(path)
            # 升级下到一半的也一起删
            part = local_model_dest(self.values) + ".part"
            if os.path.isfile(part):
                freed += os.path.getsize(part)
                os.unlink(part)
        except OSError as e:
            self.toast(f"删不掉：{e.strerror}")
        else:
            remove_llama_server()
            self.toast(f"已删除，空出 {human_size(freed)}" if freed else "已删除")
            self.fcitx.reload()
        self.refresh_local_translate()

