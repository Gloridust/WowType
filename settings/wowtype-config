                assert voice_model_ready(folder) and os.listdir(parent) == ["wtlocal"]
            # 内容不全的包不装，原来的留着
            bad = make_pack({"model/readme.txt": b"x"})
            blob["data"] = bad
            try:
                install_voice_model(**{**args, "md5": hashlib.md5(bad).hexdigest(), "size": len(bad)})
                raise AssertionError("没有模型的包应该装不上")
            except ValueError:
                pass
            assert voice_model_ready(folder) and os.listdir(parent) == ["wtlocal"]
            # 服务器出错（404）：OSError
            server.RequestHandlerClass = type("Gone", (Handler,), {
                "do_GET": lambda self: (self.send_response(404), self.end_headers())})
            shutil.rmtree(folder)
            try:
                install_voice_model(**args)
                raise AssertionError("404 应该失败")
            except OSError:
                pass
            assert not voice_model_ready(folder)
            # 从文件装；文件留着。不是 zip 的文件报 ValueError
            pack = os.path.join(tmp, "x.apk")
            with open(pack, "wb") as f:
                f.write(good)
            install_voice_model(folder, pack=pack, md5=md5, size=len(good))
