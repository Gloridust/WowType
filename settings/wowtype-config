class Fcitx:
    NAME = "org.fcitx.Fcitx5"
    PATH = "/controller"
    IFACE = "org.fcitx.Fcitx.Controller1"

    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            self.bus = None

    def call(self, method, params=None, reply=None, done=None):
        """异步调 fcitx5；done(结果或 None)。fcitx5 没在跑时 done(None)。"""
        if not self.bus:
            if done:
                done(None)
            return

        def finished(bus, result):
            try:
                value = bus.call_finish(result)
            except GLib.Error:
                value = None
            if done:
                done(value)

        self.bus.call(self.NAME, self.PATH, self.IFACE, method, params,
                      GLib.VariantType(reply) if reply else None,
                      Gio.DBusCallFlags.NO_AUTO_START, 2000, None, finished)

    def reload(self):
        self.call("ReloadAddonConfig", GLib.Variant("(s)", ("wowtype",)))

    def restart(self, done=None):
        self.call("Restart", done=lambda value: done and done(value is not None))

    def group_info(self, done):
        """done((组名, 键盘布局, [(输入法, 布局)…]) 或 None)。"""
        def got_group(value):
            if value is None:
                done(None)
                return
            group = value.unpack()[0]
            self.call("InputMethodGroupInfo", GLib.Variant("(s)", (group,)), "(sa(ss))",
                      lambda info: done(None if info is None else (group, *info.unpack())))
        self.call("CurrentInputMethodGroup", None, "(s)", got_group)

    def get_config(self, uri, done):
        """done({键: 值字符串} 或 None)。"""
        self.call("GetConfig", GLib.Variant("(s)", (uri,)), "(va(sa(sssva{sv})))",
                  lambda value: done(None if value is None else value.unpack()[0]))

    def set_config(self, uri, values, done=None):
        """只改给出的几项（fcitx5 按部分配置合并），立即生效。"""
        raw = GLib.Variant("a{sv}", {k: GLib.Variant("s", v) for k, v in values.items()})
        self.call("SetConfig", GLib.Variant("(sv)", (uri, raw)),
                  done=lambda value: done and done(value is not None))

    def add_to_group(self, group, layout, items, done):
        items = list(items) + [("wowtype", "")]
        self.call("SetInputMethodGroupInfo", GLib.Variant("(ssa(ss))", (group, layout, items)),
                  done=lambda value: done(value is not None))



