def stats_clear_count(path=None):
    """清除计数（stats.clear 里的整数）；没有文件、不是数时是 0。"""
    try:
        with open(path or STATS_CLEAR_FILE, encoding="utf-8") as f:
            value = int(f.read().strip())
    except (OSError, ValueError):
        return 0
    return value if 0 <= value < 2 ** 64 else 0


def read_stats(path=None, clear_path=None):
    """读统计文件；没有、坏了、清除过（cleared 和 stats.clear 对不上）都当成空记录。"""
    path = path or STATS_FILE
    try:
        if os.path.getsize(path) > 16 * 1024 * 1024:
            raise ValueError("太大")
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict) or data.get("cleared", 0) != stats_clear_count(clear_path):
        data = {}
    days = {}
    raw = data.get("days")
    if isinstance(raw, dict):
        for day, value in raw.items():
            if isinstance(day, str) and len(day) == 10 and isinstance(value, dict):
                days[day] = value
    return {"days": days}


def clear_stats(path=None, clear_path=None):
    """清除统计：清除计数加一（输入法据此丢掉攒着的旧计数、不写回来），再删掉统计文件。

    设置界面不改统计文件的内容，只删；输入法开着关着都行。"""
    path = path or STATS_FILE
    clear_path = clear_path or STATS_CLEAR_FILE
    count = stats_clear_count(clear_path) + 1
    if count >= 2 ** 64:
        count = 1
    write_atomic(clear_path, f"{count}\n")
    for name in (path, path + ".bad"):
        try:
            os.remove(name)
        except FileNotFoundError:
            pass


def devlog_files(path=None):
    """开发者模式的记录文件，旧的在前（换下来的 .1、现在的）；只列存在的。"""
    path = path or DEVLOG_FILE
    return [name for name in (path + ".1", path) if os.path.isfile(name)]


def devlog_summary(path=None):
    """(条数, 字节数)：一行一条。读不了的当没有。"""
    lines = size = 0
    for name in devlog_files(path):
        try:
            size += os.path.getsize(name)
            with open(name, "rb") as f:
                lines += sum(chunk.count(b"\n") for chunk in iter(lambda: f.read(1 << 20), b""))
        except OSError:
            pass
    return lines, size


def clear_devlog(path=None):
    """清空开发者模式的记录（和 core 的 devlog::clear 一样：删掉记录和换下来的旧文件）。输入法开着关着都行。"""
    path = path or DEVLOG_FILE
    for name in (path, path + ".1"):
        try:
            os.remove(name)
        except FileNotFoundError:
            pass


def export_devlog(dest, path=None):
    """把记录（旧的在前）合成一个文件存到 dest，只有自己能读。返回条数。"""
    files = devlog_files(path)
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as out:
        os.chmod(dest, 0o600)
        for name in files:
            with open(name, "rb") as f:
                shutil.copyfileobj(f, out)
    with open(dest, "rb") as f:
        return sum(chunk.count(b"\n") for chunk in iter(lambda: f.read(1 << 20), b""))


def devlog_size(n):
    return f"{n / 1e6:.1f} MB" if n >= 1e6 else f"{max(n / 1e3, 0.1):.1f} KB"


def devlog_self_test():
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, "wowtype", "devlog.jsonl")
        assert devlog_files(path) == [] and devlog_summary(path) == (0, 0)
        clear_devlog(path)  # 没有文件也不报错
