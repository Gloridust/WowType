        assert open(dest, "rb").read() == blob and not os.path.exists(dest + ".part")
        os.unlink(dest)
        with open(dest + ".part", "wb") as f:  # 续传
            f.write(blob[:123_456])
        download_model(dest, url, good)
        assert open(dest, "rb").read() == blob
        os.unlink(dest)
        with open(dest + ".part", "wb") as f:  # .part 已完整：服务回 416
            f.write(blob)
        download_model(dest, url, good)
        assert open(dest, "rb").read() == blob
        os.unlink(dest)
        try:
            download_model(dest, url, "0" * 64)
            raise AssertionError("校验不对应该报错")
        except ValueError:
            assert not os.path.exists(dest) and not os.path.exists(dest + ".part")
        try:
            download_model(dest, url, good, cancelled=lambda: True)
            raise AssertionError("取消应该报 DownloadCancelled")
        except DownloadCancelled:
            assert not os.path.exists(dest) and os.path.exists(dest + ".part")
        assert local_model_path({"TranslateLocalModel": ""}).endswith(LOCAL_MODEL_FILE)
        assert local_model_path({"TranslateLocalModel": "~/x.gguf"}) == os.path.expanduser("~/x.gguf")
        # 上一代模型：新的没下载时照旧用它，新的下好了删掉它；自己写了位置的不管
        models = os.path.join(tmp, "generations")
        os.makedirs(models)
        new, old = os.path.join(models, LOCAL_MODEL_FILE), os.path.join(models, LEGACY_MODEL_FILE)
        none, custom = {"TranslateLocalModel": ""}, {"TranslateLocalModel": "~/x.gguf"}
        assert legacy_model_path(none, models) is None and local_model_path(none, models) == new
        assert remove_legacy_model(models) == 0
        with open(old, "wb") as f:
            f.write(b"old!")
        with open(old + ".part", "wb") as f:
            f.write(b"x")
        assert legacy_model_path(none, models) == old and local_model_path(none, models) == old
        assert local_model_dest(none, models) == new, "升级下到新文件名"
        assert legacy_model_path(custom, models) is None
        assert local_model_path(custom, models) == os.path.expanduser("~/x.gguf")
        assert remove_legacy_model(models) == 0 and os.path.isfile(old), "新的还没下好不删旧的"
        with open(new, "wb") as f:
            f.write(b"new")
        assert legacy_model_path(none, models) is None and local_model_path(none, models) == new
        assert remove_legacy_model(models) == 5
        assert not os.path.exists(old) and not os.path.exists(old + ".part") and os.path.isfile(new)
    server.shutdown()


