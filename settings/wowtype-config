def current_version():
    return VERSION if not VERSION.startswith("@") else "0"


def development_build():
    """开发版（CI 打的 0.3.12~git… 包、从源码直接跑的）：版本号说不清比正式版新还是旧。"""
    return "~git" in VERSION or VERSION.startswith("@")


def parse_version(text):
    """`v0.2.1`、`0.2.1-1~ubuntu26.04`、`2026.10.31` -> 数字元组。"""
    text = text.strip().lstrip("vV").split("-")[0].split("~")[0]
    return tuple(int(n) for n in re.findall(r"\d+", text))


def dpkg_version(package):
    """已装 deb 包的版本；没装（或不是 Debian 系）返回 None。"""
    try:
        out = subprocess.run(["dpkg-query", "-W", "-f=${Status}\t${Version}", package],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    status, _, version = out.stdout.partition("\t")
    return version if out.returncode == 0 and status.endswith(" installed") else None


def read_os_release():
    """读取发行版标识，不执行 os-release 中的内容。"""
    info = {}
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    key, sep, value = line.strip().partition("=")
                    if sep and re.fullmatch(r"[A-Z_][A-Z_0-9]*", key):
                        try:
                            words = shlex.split(value, comments=True)
                            if len(words) == 1:
                                info[key] = words[0]
                        except ValueError:
                            pass
            break
        except OSError:
            continue
    return info


def update_platform(info=None, machine=None, immutable=None):
    """返回（包管理器、发布包发行版、架构、手动更新说明）。"""
    info = read_os_release() if info is None else info
    machine = os.uname().machine if machine is None else machine
    immutable = os.path.exists("/run/ostree-booted") if immutable is None else immutable
    distro = info.get("ID", "").lower()
    version = info.get("VERSION_ID", "")
    family = set(info.get("ID_LIKE", "").lower().split()) | {distro}
    variant = info.get("VARIANT_ID", "").lower()
    guide = f"安装说明：{INSTALL_GUIDE}"
    if "nixos" in family:
        return "", "", "", "NixOS 请更新 flake 输入后运行 nixos-rebuild switch；" + guide
    # deepin 25 的磐石系统基于 OSTree，但 apt-get install 照常能用，要在「不可变系统」之前认出来
    if distro == "deepin":
        codename = info.get("VERSION_CODENAME", "").lower()
        base = ("deepin25" if codename == "crimson" or re.fullmatch(r"25(\.\d+)*", version) else
                "deepin23" if codename == "beige" or re.fullmatch(r"23(\.\d+)*", version) else "")
        if not base:
            return "", "", "", f"deepin {version or codename} 没有发布包（有 deepin 23 和 25 的）；{guide}"
        if machine not in ("x86_64", "amd64"):
            return "", "", "", f"deepin 的发布包只有 x86_64，{machine} 请从源码构建；{guide}"
        return "apt-get", base, "amd64", ""
    if immutable or "atomic" in variant or variant in {
            "silverblue", "kinoite", "sericea", "onyx", "coreos"}:
        return "", "", "", "不可变系统请使用系统的分层或声明式配置更新（Fedora Atomic 用 rpm-ostree）；" + guide
    if "manjaro" in family:
        return "", "", "", "Manjaro 请用 scripts/package-arch.sh 在本机编包，避免混用 Arch 滚动库；" + guide
    # deb 和 rpm 对同一种架构叫法不同：amd64 / x86_64、arm64 / aarch64
    deb_arch, rpm_arch = {"x86_64": ("amd64", "x86_64"), "amd64": ("amd64", "x86_64"),
                          "aarch64": ("arm64", "aarch64"),
                          "arm64": ("arm64", "aarch64")}.get(machine, ("", ""))
    if not deb_arch:
        return "", "", "", f"发布包只有 x86_64 和 arm64，{machine} 请从源码构建；{guide}"
    if distro == "ubuntu" and version in ("22.04", "24.04", "26.04"):
        return "apt-get", "ubuntu" + version, deb_arch, ""
    if distro == "debian" and (version == "13" or version.startswith("13.")):
        return "apt-get", "debian13", deb_arch, ""
    # 衍生发行版只有明确声明了兼容基底才套用对应 deb，绝不拿自己的版本号猜。
    if distro not in ("ubuntu", "debian"):
        codename = info.get("UBUNTU_CODENAME", "")
        if not codename and "ubuntu" in family:
            codename = info.get("VERSION_CODENAME", "")
        ubuntu = {"jammy": "22.04", "noble": "24.04", "resolute": "26.04"}.get(codename)
        if ubuntu:
            return "apt-get", "ubuntu" + ubuntu, deb_arch, ""
        codename = info.get("DEBIAN_CODENAME", "")
        if not codename and "debian" in family:
            codename = info.get("VERSION_CODENAME", "")
        if codename == "trixie":
            return "apt-get", "debian13", deb_arch, ""
    if family & {"arch", "archlinux", "endeavouros", "garuda", "cachyos"}:
        if rpm_arch != "x86_64":
            return "", "", "", (f"Arch Linux 的发布包只有 x86_64，{machine} 请用 "
                                f"scripts/package-arch.sh 在本机编包；{guide}")
        return "pacman", "archlinux", "x86_64", ""
    if distro == "fedora" and re.fullmatch(r"[0-9]+", version):
        return "dnf", "fc" + version, rpm_arch, ""
    return "", "", "", f"{distro or '这个发行版'} 请按发行版说明从源码更新；{guide}"


def package_version(manager, package=ENGINE_PKG):
    """查询对应包管理器，源码安装不会误走二进制更新。"""
    if manager == "apt-get":
        return dpkg_version(package)
    commands = {"pacman": ["pacman", "-Q", package],
                "dnf": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", package]}
    if manager not in commands:
        return None
    try:
        result = subprocess.run(commands[manager], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value.split(" ", 1)[-1] if value else None


def install_commands(manager, paths):
    """使用参数列表调用包管理器。Arch 只 -U，不替用户 -Syu（依赖不满足时 pacman 会报错）。"""
    if not paths or any(not os.path.isabs(path) for path in paths):
        raise ValueError("安装包必须是已校验的本地绝对路径")
    if manager == "apt-get":
        return [["pkexec", "apt-get", "install", "-y", *paths]]
    if manager == "dnf":
        return [["pkexec", "dnf", "install", "-y", *paths]]
    if manager == "pacman":
        return [["pkexec", "pacman", "-U", "--noconfirm", *paths]]
    raise ValueError("这个系统请按安装说明手动更新")


def http_open(url, timeout=30):
    request = urllib.request.Request(url, headers={
        "User-Agent": f"WowType-Updater/{current_version()}",
        "Accept": "application/vnd.github+json" if "api.github.com" in url else "*/*",
    })
    return urllib.request.urlopen(request, timeout=timeout)


_MD_INLINE = re.compile(r"\*\*(.+?)\*\*|`([^`]+)`|\[([^\]]+)\]\((https?://[^)\s]+)\)|(https?://[^\s<>()]+)")


def _md_inline(text):
    """一行 Markdown 里的粗体、代码、链接 → Pango 标记，其余文字转义。"""
    out, pos = [], 0
    for m in _MD_INLINE.finditer(text):
        out.append(GLib.markup_escape_text(text[pos:m.start()]))
        bold, code, label, href, bare = m.groups()
        if bold is not None:
            out.append(f"<b>{_md_inline(bold)}</b>")
        elif code is not None:
            out.append(f"<tt>{GLib.markup_escape_text(code)}</tt>")
        elif label is not None:
            out.append(f'<a href="{GLib.markup_escape_text(href)}">{GLib.markup_escape_text(label)}</a>')
        else:
            url = GLib.markup_escape_text(bare)
            out.append(f'<a href="{url}">{url}</a>')
        pos = m.end()
    out.append(GLib.markup_escape_text(text[pos:]))
    return "".join(out)


def release_highlights(notes):
    """发布说明里只留「## 这一版」（发布任务写的是「## 这一版要注意」）那一节（去掉标题本身）；没有这一节就原样返回。

    后面的安装步骤、自动生成的提交列表对已经装好的人没用，放进「更新内容」只会很长。
    """
    lines = notes.strip().splitlines()
    for i, line in enumerate(lines):
        if re.match(r"^##\s*这一版(要注意)?\s*$", line.strip()):
            body = []
            for rest in lines[i + 1:]:
                if re.match(r"^#{1,2}\s", rest):
                    break
                body.append(rest)
            text = "\n".join(body).strip()
            return text or notes.strip()
    return notes.strip()


def markdown_to_pango(md):
    """GitHub Release 说明（Markdown）→ Gtk.Label 能显示的 Pango 标记。

    只认 Release 说明里会用到的：标题、列表（含缩进的子项）、代码块、粗体、行内代码、链接。
    """
    lines, in_code = [], False
    for raw in md.replace("\r\n", "\n").split("\n"):
        line = raw.rstrip()
        if line.lstrip().startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            lines.append("    <tt>" + GLib.markup_escape_text(line) + "</tt>")
            continue
        heading = re.match(r"(#{1,6})\s+(.*)", line)
        item = re.match(r"(\s*)[-*+]\s+(.*)", line)
        if heading:
            size = "large" if len(heading.group(1)) <= 2 else "medium"
            if lines and lines[-1] != "":
                lines.append("")
            lines.append(f'<span size="{size}" weight="bold">{_md_inline(heading.group(2))}</span>')
        elif item:
            depth = len(item.group(1).expandtabs(2)) // 2
            bullet = "•" if depth == 0 else "◦"
            lines.append("    " * depth + f"{bullet} {_md_inline(item.group(2))}")
        elif not line.strip():
            if lines and lines[-1] != "":
                lines.append("")
        else:
            lines.append(_md_inline(line.strip()))
    while lines and lines[-1] == "":
        lines.pop()
    # 整段标成简体中文：跟在英文后面的「。」也用简体字形
    return '<span lang="zh-cn">' + "\n".join(lines) + "</span>"


def release_info(data):
    """GitHub 发布的 JSON -> {tag, version, notes, url, prerelease, assets: {文件名: 下载地址}}。"""
    return {
        "tag": data.get("tag_name", ""),
        "version": data.get("tag_name", "").lstrip("vV"),
        "notes": data.get("body") or "",
        "url": data.get("html_url") or RELEASES_PAGE,
        "prerelease": bool(data.get("prerelease")),
        "assets": {a["name"]: a["browser_download_url"] for a in data.get("assets", [])},
    }


def pick_release(releases):
    """Beta 计划：发布列表（GitHub 的 JSON）里版本号最大的那个，预发布也算；一样大时要正式版。

    只看 v 加数字开头的 tag：数据的发布（lm-…、nnlm-…）也是预发布，不是新版本。草稿不算。没有合适的返回 None。"""
    best = None
    for data in releases:
        tag = data.get("tag_name") or ""
        if data.get("draft") or not re.fullmatch(r"[vV]\d+(\.\d+)*", tag):
            continue
        key = (parse_version(tag), not data.get("prerelease"))
        if best is None or key > best[0]:
            best = (key, data)
    return release_info(best[1]) if best else None


def beta_updates(values=None):
    """设置里开了 Beta 计划（接收预发布版）。"""
    if values is None:
        values, _ = read_config()
    return values.get("BetaUpdates") == "True"


def fetch_latest(beta=None):
    """GitHub 上最新的正式版；Beta 计划开着时是最新的版本（预发布也算）。beta 不给时按设置。

    先走网页（fetch_latest_web，不算接口次数）；网页那条路走不通时（GitHub 改了页面之类）再问接口。"""
    if beta is None:
        beta = beta_updates()
    try:
        return fetch_latest_web(beta)
    except OSError as web_error:
        try:
            return fetch_latest_api(beta)
        except OSError:
            raise web_error from None


def fetch_latest_api(beta):
    """问 GitHub 接口。不登录时每个 IP 每小时只能问 60 次（校园网、公司网、运营商 NAT 后面很多人共用一个 IP），
    用完了回 403，所以只在网页那条路走不通时用。"""
    if beta:
        with http_open(RELEASES_API, timeout=20) as response:
            picked = pick_release(json.load(response))
        if picked:
            return picked
    with http_open(RELEASE_API, timeout=20) as response:
        return release_info(json.load(response))


APP_TAG = re.compile(r"[vV]\d+(\.\d+)*")


def fetch_latest_web(beta):
    """不走接口：最新正式版的 tag 从 releases/latest 跳到的地址里取；Beta 计划开着时再看 releases.atom，
    从版本号最大的往下试（一样大要正式版）。文件列表从这一版的 SHA256SUMS 读。

    releases.atom 里也有只推了 tag、还没发出来（正在构建）的版本，它们没有 SHA256SUMS（404），跳过。"""
    with http_open(RELEASES_LATEST_PAGE, timeout=20) as response:
        match = re.search(r"/releases/tag/([^/?#]+)$", response.geturl())
    latest = urllib.parse.unquote(match.group(1)) if match else ""
    tags = [latest] if APP_TAG.fullmatch(latest) else []
    if beta:
        with http_open(RELEASES_ATOM, timeout=20) as response:
            feed = response.read().decode("utf-8", "replace")
        for found in re.findall(r"/releases/tag/([^\"'<>/?#]+)", feed):
            found = urllib.parse.unquote(found)
            if APP_TAG.fullmatch(found) and found not in tags:
                tags.append(found)
    # 版本号大的在前，一样大时正式版（latest）在前
    tags.sort(key=lambda t: (parse_version(t), t == latest), reverse=True)
    for tag in tags:
        try:
            return web_release(tag, prerelease=tag != latest)
        except urllib.error.HTTPError as e:
            if e.code != 404 or tag == latest:
                raise
    raise OSError("GitHub 上找不到发布的版本")


def web_release(tag, prerelease=False):
    """不走接口拼出 release_info 的样子：下载地址按发布页的规则拼，有哪些文件看 SHA256SUMS。
    更新说明只在比现在装的新时才取（只有那时显示），见 release_notes。"""
    base = f"{RELEASES_DOWNLOAD}/{urllib.parse.quote(tag)}"
    with http_open(f"{base}/SHA256SUMS", timeout=20) as response:
        sums = response.read().decode("utf-8", "replace")
    assets = {"SHA256SUMS": f"{base}/SHA256SUMS"}
    for line in sums.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and re.fullmatch(r"[0-9A-Fa-f]{64}", parts[0]):
            name = parts[1].lstrip("*").strip()
            if name and "/" not in name:
                assets[name] = f"{base}/{urllib.parse.quote(name)}"
    url = f"{HOMEPAGE}/releases/tag/{urllib.parse.quote(tag)}"
    newer = parse_version(tag) > parse_version(current_version())
    return {
        "tag": tag,
        "version": tag.lstrip("vV"),
        "notes": release_notes(tag, base, url) if newer else "",
        "url": url,
        "prerelease": prerelease,
        "assets": assets,
    }


def release_notes(tag, base, url):
    """这一版的更新说明：先下发布页上的 RELEASE-NOTES.md（不算接口次数）；更早的版本没有这个文件，问一次接口；
    都拿不到时一句「见发布页」。拿不到说明不算检查失败。"""
    try:
        with http_open(f"{base}/{RELEASE_NOTES_FILE}", timeout=20) as response:
            return response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        if e.code != 404:
            return f"没取到更新说明，见[发布页]({url})。"
    except OSError:
        return f"没取到更新说明，见[发布页]({url})。"
    try:
        with http_open(RELEASE_TAG_API.format(tag=urllib.parse.quote(tag)), timeout=20) as response:
            return json.load(response).get("body") or ""
    except (OSError, ValueError):
        return f"没取到更新说明，见[发布页]({url})。"


def is_newer(release):
    return parse_version(release["version"]) > parse_version(current_version())


def plan_update(release):
    """要下载的包：[(文件名, 地址)]，和一段说明。装不了时列表为空，说明里写原因。"""
    manager, distro, arch, reason = update_platform()
    if reason:
        return [], reason
    if package_version(manager) is None:
        return [], f"当前未通过 {manager} 安装 WowType，请按安装说明更新源码或系统配置"
    version = release["version"]
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~^-]*", version):
        return [], "发布版本号格式无效，请到下载页检查"
    if manager == "apt-get":
        name = f"wowtype_{version}_{distro}_{arch}.deb"
    elif manager == "pacman":
        name = f"wowtype-{version}-1-{arch}.pkg.tar.zst"
    else:
        name = f"wowtype-{version}-1.{distro}.{arch}.rpm"
    if name not in release["assets"]:
        return [], f"这一版没有 {distro} {arch} 的安装包，请按安装说明从源码构建，不混用其他发行版的包"
    if "SHA256SUMS" not in release["assets"]:
        return [], "发布页缺少 SHA256SUMS，暂不安装，请到下载页检查"
    reason = "要是提示依赖不满足，先在终端运行 sudo pacman -Syu 升级系统" if manager == "pacman" else ""
    return [(name, release["assets"][name])], reason


def download_updates(release, files, progress):
    """下载并按 SHA256SUMS 校验，返回本地路径列表。progress(已下字节, 总字节)。"""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~^-]*", release["tag"]):
        raise RuntimeError("发布标签格式无效，不安装")
    folder = os.path.join(UPDATE_DIR, release["tag"])
    os.makedirs(folder, exist_ok=True)
    sums = {}
    wanted = {name for name, _url in files}
    if "SHA256SUMS" in release["assets"]:
        with http_open(release["assets"]["SHA256SUMS"]) as response:
            for line in response.read().decode("utf-8", "replace").splitlines():
                fields = line.strip().split(maxsplit=1)
                if len(fields) != 2:
                    continue
                digest, name = fields
                name = name.removeprefix("*")
                if name not in wanted:
                    continue
                if name in sums or not re.fullmatch(r"[0-9a-fA-F]{64}", digest):
                    raise RuntimeError(f"SHA256SUMS 中 {name} 的校验值重复或无效，不安装")
                sums[name] = digest.lower()
    paths = []
    for name, url in files:
        if os.path.basename(name) != name or name in (".", ".."):
            raise RuntimeError("发布包文件名无效，不安装")
        if name not in sums:
            raise RuntimeError(f"SHA256SUMS 里没有 {name}，不安装")
        path = os.path.join(folder, name)
        digest = hashlib.sha256()
        with http_open(url, timeout=60) as response, open(path + ".part", "wb") as out:
            total = int(response.headers.get("Content-Length") or 0)
            done = 0
            while chunk := response.read(1 << 16):
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                progress(done, total)
        if digest.hexdigest() != sums[name]:
            os.unlink(path + ".part")
            raise RuntimeError(f"{name} 校验和不对，可能没下完整，请重试")
        os.replace(path + ".part", path)
        paths.append(path)
    return paths


def read_update_state():
    try:
        with open(UPDATE_STATE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_update_state(state):
    try:
        write_atomic(UPDATE_STATE, json.dumps(state))
    except OSError:
        pass


def background_check():
    """fcitx5 切到 WowType 时在后台跑（wowtype-config --check-update）。

    最多一小时查一次；有新版本就发一条桌面通知（同一版本只提醒一次），点开进设置的「更新」页。
    """
    values, _ = read_config()
    if values.get("CheckUpdate") != "True":
        return 0
    state = read_update_state()
    if time.time() - state.get("checked", 0) < CHECK_INTERVAL:
        return 0
    try:
        release = fetch_latest(beta_updates(values))
    except Exception:  # 没网、被限流：下次再说
        return 0
    state["checked"] = time.time()
    write_update_state(state)
    try:
        auto_update_lexicon(values, release, state)
    except Exception as e:  # noqa: BLE001  词库没更新好也别耽误提醒新版本
        log(f"万象词库自动更新出错：{e!r}")
    if not is_newer(release):
        # 已经是最新版：应用内更新下载的安装包用不上了（每版三十多 MB），清掉
        shutil.rmtree(UPDATE_DIR, ignore_errors=True)
        return 0
    if state.get("notified") == release["tag"]:
        return 0
    # NixOS、Manjaro、源码安装等没法一键装，通知里别说「一键安装」
    manager, _distro, _arch, reason = update_platform()
    one_click = not reason and package_version(manager) is not None
    hint = "一键安装" if one_click else "看怎么更新"

    def shown():  # 同一版本只提醒一次；发不出去的下次再发
        state["notified"] = release["tag"]
        write_update_state(state)
    beta = "（预发布）" if release.get("prerelease") else ""
    chosen = notify(f"WowType {release['version']}{beta} 可以更新了",
                    f"当前是 {current_version()}。打开设置可以看更新内容，{hint}。",
                    [("open", "查看更新"), ("default", "查看更新")], shown=shown)
    if chosen in ("open", "default"):
        open_settings_detached("update")
    return 0

# ---------------------------------------------------------------- 词库

# 默认词库是雾凇（rime-ice），在安装包里。万象拼音（rime_wanxiang）是可选词库包：
# 每次发版时 CI 用 scripts/make-wanxiang.sh 打成 wowtype-data-wanxiang-<版本>.tar.gz 放在 Release 上，
# 这里下载、按 SHA256SUMS 校验后解到 DICTS_DIR/wanxiang/，再把 Lexicon= 写进 wowtype.conf
DICTS_DIR = os.path.join(DATA_DIR, "dicts")
WANXIANG_DIR = os.path.join(DICTS_DIR, "wanxiang")
WANXIANG_LEXICON = os.path.join(WANXIANG_DIR, "lexicon.tsv")
WANXIANG_ASSET = re.compile(r"wowtype-data-wanxiang-([0-9][0-9A-Za-z.]*)\.tar\.gz")
WANXIANG_PAGE = "https://github.com/amzxyz/rime_wanxiang"
LEXICON_PACK_FILES = ("lexicon.tsv", "LICENSE", "SOURCE.txt", "VERSION")
# 包里至少这么多条才算像样的词库（防止下到一个坏包把输入法弄得没词）
LEXICON_PACK_MIN = 100000


def active_lexicon(values):
    """配置里用的是哪个词库：("rime-ice" | "wanxiang" | "custom", 路径)。

    Lexicon 留空或文件不在时插件用默认词库，这里也算 rime-ice。"""
    path = os.path.expanduser(values.get("Lexicon", "").strip())
    if not path or not os.path.isfile(path):
        return "rime-ice", ""
    if os.path.abspath(path) == os.path.abspath(WANXIANG_LEXICON):
        return "wanxiang", path
    return "custom", path


def lexicon_pack_version(folder=WANXIANG_DIR):
    """装好的词库包的版本，没装返回 None。"""
    if not os.path.isfile(os.path.join(folder, "lexicon.tsv")):
        return None
    try:
        with open(os.path.join(folder, "VERSION"), encoding="utf-8") as f:
            return f.read().strip() or "?"
    except OSError:
        return "?"


def find_lexicon_asset(release, pattern=WANXIANG_ASSET):
    """发布里的词库包：(文件名, 地址, 版本)，没有返回 None。有好几个时取版本最大的。"""
    found = []
    for name, url in (release or {}).get("assets", {}).items():
        match = pattern.fullmatch(name)
        if match:
            found.append((parse_version(match.group(1)), match.group(1), name, url))
    if not found:
        return None
    _key, version, name, url = max(found)
    return name, url, version


def install_lexicon_pack(tarball, folder=WANXIANG_DIR):
    """把词库包解到 folder（先解到旁边的临时目录，检查好了再换进去），返回版本。

    只认 LEXICON_PACK_FILES 里的普通文件，别的（目录、链接、../ 路径）一律不解。
    旧目录连同它的词库快照（lexicon.tsv.wcache）一起删掉，插件下次载入时重建快照。"""
    import tarfile
    parent = os.path.dirname(folder)
    os.makedirs(parent, exist_ok=True)
    staging = folder + ".new"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(staging)
    try:
        with tarfile.open(tarball, "r:gz") as tar:
            for member in tar.getmembers():
                name = member.name.removeprefix("./")
                if not name or name == ".":
                    continue
                if name not in LEXICON_PACK_FILES or not member.isfile():
                    raise ValueError(f"词库包里有不认识的文件 {member.name}，不安装")
                source = tar.extractfile(member)
                with source, open(os.path.join(staging, name), "wb") as out:
                    shutil.copyfileobj(source, out)
        lexicon = os.path.join(staging, "lexicon.tsv")
        if not os.path.isfile(lexicon):
            raise ValueError("词库包里没有 lexicon.tsv，不安装")
        count = 0
        with open(lexicon, encoding="utf-8") as f:
            for line in f:
                if line.startswith("#") or not line.strip():
                    continue
                if len(line.rstrip("\n").split("\t")) < 2:
                    raise ValueError("lexicon.tsv 格式不对（应为 拼音<TAB>词<TAB>频次），不安装")
                count += 1
        if count < LEXICON_PACK_MIN:
            raise ValueError(f"lexicon.tsv 只有 {count} 条，像是不完整，不安装")
        old = folder + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.exists(folder):
            os.replace(folder, old)
        os.replace(staging, folder)
        shutil.rmtree(old, ignore_errors=True)
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise
    return lexicon_pack_version(folder)


def remove_lexicon_pack(folder=WANXIANG_DIR):
    """删掉词库包（和它的词库快照），返回空出的字节数。"""
    size = dir_size(folder) if os.path.isdir(folder) else 0
    shutil.rmtree(folder, ignore_errors=True)
    return size


# 后台更新万象词库失败（下不全、包不对）后，同一版本隔这么久再试，免得每小时都下一遍
LEXICON_RETRY = 24 * 3600


def lexicon_update_plan(values, installed, release, failed=None, now=None):
    """后台要不要更新万象词库：要就返回发布里的 (文件名, 地址, 版本)，不要是 None。

    只更新装了、正在用的万象（装了没在用的，打开设置「输入 → 词库」时再手动更新）；
    发布页上的包比装好的新才更新（装好的没写版本也算旧）。failed 是上次失败的 {version, at}。"""
    if not installed or active_lexicon(values)[0] != "wanxiang":
        return None
    asset = find_lexicon_asset(release)
    if not asset or parse_version(asset[2]) <= parse_version(installed):
        return None
    now = time.time() if now is None else now
    if failed and failed.get("version") == asset[2] and now - failed.get("at", 0) < LEXICON_RETRY:
        return None
    return asset


def auto_update_lexicon(values, release, state):
    """--startup 的后台检查顺带做：万象词库有新版就在后台下载、按 SHA256SUMS 校验、换进去
    （install_lexicon_pack：先解到旁边，检查好了再整个换），再让插件重新读（换词库几秒后生效），不打扰用户。
    state 是 update-check.json 的内容，失败时记下版本，隔一天再试。"""
    folder = WANXIANG_DIR
    installed = lexicon_pack_version(folder)
    asset = lexicon_update_plan(values, installed, release, state.get("lexicon_failed"))
    if not asset:
        return None
    name, url, version = asset
    log(f"万象词库 {installed} 有新版 {version}，在后台更新")
    try:
        path = download_updates(release, [(name, url)], lambda _done, _total: None)[0]
        try:
            version = install_lexicon_pack(path, folder)
        finally:
            os.unlink(path)
    except Exception as e:  # noqa: BLE001  网络错误各式各样；包不对时 install_lexicon_pack 什么都不动
        state["lexicon_failed"] = {"version": version, "at": time.time()}
        write_update_state(state)
        log(f"万象词库 {version} 没更新好：{e}")
        return None
    state.pop("lexicon_failed", None)
    write_update_state(state)
    running = fcitx_call_sync("ReloadAddonConfig", GLib.Variant("(s)", ("wowtype",))) is not None
    log(f"万象词库更新到 {version}" + ("，插件在后台换词库" if running else "，fcitx5 下次启动时生效"))
    return version


def install_lexicon_cli(args):
    """命令行：--install-lexicon wanxiang|<文件.tar.gz> 下载/装上万象并切过去，--use-lexicon rime-ice 切回。"""
    values, extra = read_config()
    if args[0] == "--use-lexicon":
        if args[1:] != ["rime-ice"] and args[1:] != ["wanxiang"]:
            print("用法：wowtype-config --use-lexicon rime-ice|wanxiang")
            return 2
        if args[1] == "wanxiang" and not lexicon_pack_version():
            print("还没装万象词库，先运行 wowtype-config --install-lexicon wanxiang")
            return 1
        values["Lexicon"] = WANXIANG_LEXICON if args[1] == "wanxiang" else ""
    else:
        source = args[1] if len(args) > 1 else "wanxiang"
        if source == "wanxiang":
            release = fetch_latest()
            asset = find_lexicon_asset(release)
            if not asset:
                print(f"最新版 {release['version']} 的发布页上还没有万象词库包")
                return 1
            name, url, version = asset

            def progress(done, total):
                text = f"{human_size(done)} / {human_size(total)}" if total else human_size(done)
                print(f"\r下载 {name}：{text}   ", end="", flush=True)
            path = download_updates(release, [(name, url)], progress)[0]
            print()
        else:
            path = source
        version = install_lexicon_pack(path)
        if source == "wanxiang":
            os.unlink(path)
        print(f"万象词库 {version} 装好了：{WANXIANG_DIR}")
        values["Lexicon"] = WANXIANG_LEXICON
    write_config(values, extra)
    log(f"词库改为 {active_lexicon(values)[0]}（命令行）")
    running = fcitx_call_sync("ReloadAddonConfig", GLib.Variant("(s)", ("wowtype",))) is not None
    print("已切到" + ("万象拼音" if values["Lexicon"] else "雾凇拼音（默认）") +
          ("，fcitx5 正在后台换词库，过几秒生效" if running else "，fcitx5 下次启动时生效"))
    return 0


