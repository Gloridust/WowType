def new_css_supported():
    """libadwaita 1.6、GTK 4.16 起颜色是 CSS 变量（--window-bg-color 这些）。"""
    return (Gtk.get_major_version(), Gtk.get_minor_version()) >= (4, 16) and Adw.get_minor_version() >= 6


def accent_colors(accent):
    """强调色的 (色板, 放白字的底, 深色背景上当字用)；认不出的用绿色。"""
    _name, _value, color, strong, light = next(
        (item for item in SETTINGS_ACCENTS if item[1] == accent), SETTINGS_ACCENTS[0])
    return color, strong, light


def forced_css(dark):
    """主题固定时盖过系统主题颜色的那一段（见 FORCED_COLORS）。"""
    lines = []
    variables = []
    for name, (bg, fg) in FORCED_COLORS[dark].items():
        lines.append(f"@define-color {name}_bg_color {bg};")
        lines.append(f"@define-color {name}_fg_color {fg};")
        variables.append(f"--{name}-bg-color: {bg}; --{name}-fg-color: {fg};")
    css = "\n".join(lines) + "\n"
    if new_css_supported():
        css += ":root { " + " ".join(variables) + " }\n"
    return css


def theme_css(dark, accent="Green"):
    """设置窗口的整段样式。dark 只决定旧版 libadwaita 上强调色当字用时的颜色，别的颜色都跟着主题。"""
    color, strong, light = accent_colors(accent)
    new_css = new_css_supported()
    css = STYLE + STYLE_ACCENT
    if new_css:
        css += STYLE_ACCENT_VARS + STYLE_DIM_VARS
        if Gtk.get_minor_version() >= 20:
            css += STYLE_DIM_HIGH_CONTRAST
    else:
        css += STYLE_DIM_OLD
    named = {name: (f"var(--{name.replace('_', '-')}-color)" if new_css else f"@{name}_color")
             for name in ("window_bg", "window_fg", "card_bg", "card_fg")}
    accent_text = light if dark else strong
    values = {**named, "accent": color, "strong": strong, "accent_text_hex": accent_text,
              "accent_text": "var(--accent-color)" if new_css else accent_text}
    for name, value in values.items():
        css = css.replace("{" + name + "}", value)
    return css


