# ---------------------------------------------------------------- 文件读写


def read_config():
    """读 wowtype.conf，返回 (值, 原文里不认识的行)。"""
    values = dict(DEFAULTS)
    extra = []
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return values, extra
    for line in lines:
        key, sep, value = line.partition("=")
        key = key.strip()
        if sep and key in DEFAULTS:
            values[key] = value.strip().strip('"')
        elif line.strip():
            extra.append(line)
    return values, extra


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def write_config(values, extra):
    lines = [f"{key}={values[key]}" for key in DEFAULTS]
    write_atomic(CONFIG_FILE, "\n".join(lines + extra) + "\n")


def log(message):
    """往共用日志里记一行（和插件同一个文件，标成 settings）。写不了就算了。"""
    if LOG_FILE == "0":
        return
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        now = time.time()
        stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now))
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"{stamp}.{int(now * 1000) % 1000:03d} I settings {message}\n")
    except OSError:
        pass


