def _kconfig_tool(name):
    return shutil.which(f"{name}6") or shutil.which(f"{name}5")


def kwin_input_method():
    """KDE Plasma Wayland 下由 KWin 拉起 fcitx5 时，返回 kwinrc 里 [Wayland] InputMethod 的值，否则 None。

    这种情况下 fcitx5 用的是 KWin 交给它的 WAYLAND_SOCKET（zwp_input_method_v1），
    fcitx5 认为自己不能重启：D-Bus 的 Restart 什么都不做（Instance::restart 里 canRestart() 为假直接返回）；
    `fcitx5 -r` 起来的新进程拿不到这个连接，新打开的 Wayland 程序里就打不了字。
    只能让 KWin 自己再拉起一次。
    """
    if not os.environ.get("WAYLAND_DISPLAY"):
        return None
    if "KDE" not in os.environ.get("XDG_CURRENT_DESKTOP", "").upper().split(":"):
        return None
    tool = _kconfig_tool("kreadconfig")
    if not tool:
        return None
    try:
        value = subprocess.run([tool, "--file", "kwinrc", "--group", "Wayland", "--key", "InputMethod"],
                               capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return value if "fcitx" in value.lower() else None


def _kwinrc_has_user_input_method():
    """用户自己的 kwinrc 里有没有写 InputMethod（没有的话值来自 /etc/xdg 等系统默认）。"""
    try:
        with open(KWINRC_FILE, encoding="utf-8") as f:
            section = None
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    section = line
                elif section == "[Wayland]" and re.match(r"InputMethod(\[\$[a-z]+\])?\s*=", line):
                    return True
    except OSError:
        pass
    return False


def restart_fcitx_via_kwin(launcher):
    """让 fcitx5 退出，再改一下 kwinrc 的 InputMethod（带 --notify）让 KWin 重新拉起它。成功返回 True。"""
    tool = _kconfig_tool("kwriteconfig")
    if not tool:
        return False
    base = [tool, "--file", "kwinrc", "--group", "Wayland", "--key", "InputMethod", "--notify"]
    user_value = _kwinrc_has_user_input_method()
    fcitx_call_sync("Exit")
    for _ in range(20):  # 最多等 5 秒退出
        if fcitx_call_sync("CurrentInputMethodGroup", None, "(s)") is None:
            break
        time.sleep(0.25)
    # 先清空（KWin 停掉旧的输入法），再写回去（KWin 重新启动它）。
    # 写回：原来是用户写的就写回原值；原来来自系统默认就删掉用户这项，回到默认
    restore = base + ([launcher] if user_value else ["--delete"])
    try:
        subprocess.run(base + [""], check=True, timeout=5)
        time.sleep(0.5)
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        subprocess.run(restore, check=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    for _ in range(60):  # 最多等 15 秒 fcitx5 起来
        time.sleep(0.25)
        if fcitx_call_sync("CurrentInputMethodGroup", None, "(s)") is not None:
            return True
    return False


def restart_fcitx_sync():
    """重启 fcitx5。KDE Wayland 下经 KWin 重启，其他环境用 D-Bus 的 Restart。"""
    launcher = kwin_input_method()
    if launcher:
        return restart_fcitx_via_kwin(launcher)
    return fcitx_call_sync("Restart") is not None


# ---------------------------------------------------------------- 升级后提醒重启输入法
#
# 包管理器或应用内更新换掉了插件，正在跑的 fcitx5 还载着旧的，新功能不生效。
# 插件在会话总线上的 org.wowtype.Input1 有 Version（0.4.1 起）：和设置界面自己的版本（同一个包装的）不一样，
# 或者没有这个方法（旧插件），就是要重启输入法。

ADDON_BUS = ("org.wowtype.Input", "/org/wowtype/Input", "org.wowtype.Input1")
# 服务在、方法不在：旧插件。别的错（服务不在、超时）说不清，不提醒
OLD_ADDON_ERRORS = frozenset({"org.freedesktop.DBus.Error.UnknownMethod",
                              "org.freedesktop.DBus.Error.UnknownInterface",
                              "org.freedesktop.DBus.Error.UnknownObject"})
RESTART_NOTE = "重启后，Chrome、VS Code、微信等 Chromium / Electron 程序要彻底退出再打开才能打中文。"


def addon_version_from(reply, error_name=None):
    """Version 的回复 → 正在跑的插件版本；"" 是没有 Version 的旧插件（0.4.0 及以前）；None 是说不清。"""
    if error_name is None:
        return reply or None
    return "" if error_name in OLD_ADDON_ERRORS else None


def dbus_error_name(error):
    if Gio.DBusError.is_remote_error(error):
        return Gio.DBusError.get_remote_error(error)
    return "?"


def running_addon_version():
    """问正在跑的插件是哪个版本（同步，命令行和 --startup 用），见 addon_version_from。"""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        value = bus.call_sync(*ADDON_BUS, "Version", None, GLib.VariantType("(s)"),
                              Gio.DBusCallFlags.NO_AUTO_START, 3000, None)
    except GLib.Error as e:
        return addon_version_from(None, dbus_error_name(e))
    return addon_version_from(value.unpack()[0])


def restart_needed(running, installed=None):
    """正在跑的插件（running_addon_version 的结果）和装好的不是同一版：要重启输入法。

    从源码直接跑的设置界面（版本号还是没替换的占位串，以 @ 开头）不算。"""
    installed = VERSION if installed is None else installed
    if running is None or installed.startswith("@"):
        return False
    return running != installed


def notify(summary, body, actions=(), timeout=24 * 3600, shown=None):
    """发桌面通知（org.freedesktop.Notifications，notify-send 走的也是它），等用户点。

    actions：[(动作名, 按钮文字)…]，点通知本身是 "default"。发不出去（没有会话总线、没有通知服务）返回 None；
    发出去了先调 shown()，再等到点了按钮（返回动作名）、关掉或超时（返回 ""）。
    用自己的主循环上下文，可以在别的线程里等。"""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except GLib.Error:
        return None
    context = GLib.MainContext.new()
    context.push_thread_default()
    loop = GLib.MainLoop.new(context, False)
    state = {"id": None, "action": ""}

    def on_signal(_bus, _sender, _path, _iface, signal, params):
        if state["id"] is None or params[0] != state["id"]:
            return
        if signal == "ActionInvoked":
            state["action"] = params[1]
        loop.quit()
    subscriptions = [bus.signal_subscribe(None, "org.freedesktop.Notifications", signal,
                                          "/org/freedesktop/Notifications", None,
                                          Gio.DBusSignalFlags.NONE, on_signal)
                     for signal in ("ActionInvoked", "NotificationClosed")]
    try:
        flat = [text for action in actions for text in action]
        hints = {"desktop-entry": GLib.Variant("s", APP_ID)}
        try:
            reply = bus.call_sync(
                "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications", "Notify",
                GLib.Variant("(susssasa{sv}i)", ("WowType", 0, "wowtype", summary, body, flat, hints, -1)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 10000, None)
        except GLib.Error as e:
            log(f"桌面通知发不出去：{e.message}")
            return None
        state["id"] = reply.unpack()[0]
        if shown:
            shown()
        if not actions:
            return ""
        timer = GLib.timeout_source_new_seconds(timeout)
        timer.set_callback(lambda *_: loop.quit() or False)
        timer.attach(context)
        loop.run()
        timer.destroy()
        return state["action"]
    finally:
        for sub in subscriptions:
            bus.signal_unsubscribe(sub)
        context.pop_thread_default()


def open_settings_detached(page):
    """另起一个设置窗口（不跟着这个进程退出）。"""
    try:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--page", page],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        log(f"打不开设置：{e}")


def restart_reminder():
    """--startup 里：升级以后 fcitx5 还载着旧插件时发通知，点了「重启输入法」再重启（不静默重启：
    Chromium / Electron 程序要跟着重开）。同一版本只提醒一次，通知发不出去不算提醒过。"""
    running = running_addon_version()
    if not restart_needed(running):
        return
    installed = current_version()
    if read_state().get("restart_reminded") == installed:
        return
    log(f"正在跑的插件是 {running or '0.4.0 及以前'}，装好的是 {installed}：提醒重启输入法")
    action = notify(f"WowType 已更新到 {installed}，重启输入法后生效",
                    f"正在用的还是旧版（{running or '0.4.0 及以前'}）。{RESTART_NOTE}",
                    [("restart", "重启输入法"), ("default", "打开设置")],
                    shown=lambda: update_state(restart_reminded=installed))
    if action == "restart":
        ok = restart_fcitx_sync()
        log("从通知重启输入法：" + ("好了" if ok else "失败"))
        if not ok:
            notify("重启输入法失败", "可以注销后重新登录。")
    elif action == "default":
        open_settings_detached("general")


def system_keyboard_layout():
    """fcitx5 键盘布局的名字（us、de-nodeadkeys……），从 localectl 读，读不到用 us。"""
    layout = variant = ""
    try:
        out = subprocess.run(["localectl", "status"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    for line in out.splitlines():
        key, _, value = line.strip().partition(":")
        value = value.strip().split(",")[0].strip()
        if key == "X11 Layout":
            layout = value
        elif key == "X11 Variant":
            variant = value
    layout = layout or "us"
    return f"{layout}-{variant}" if variant else layout


def profile_add_wowtype(path=None):
    """fcitx5 没在跑时直接改它的配置文件 profile（默认 PROFILE_FILE），把 WowType 加进第一个分组。

    没有 profile（fcitx5 还没运行过）就新建一个：系统键盘布局 + WowType。
    fcitx5 退出时会把内存里的分组写回 profile，所以只能在它没在跑时改。返回说明文字。
    """
    path = path or PROFILE_FILE
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        layout = system_keyboard_layout()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"[Groups/0]\nName=Default\nDefault Layout={layout}\nDefaultIM=wowtype\n\n"
                    f"[Groups/0/Items/0]\nName=keyboard-{layout}\nLayout=\n\n"
                    "[Groups/0/Items/1]\nName=wowtype\nLayout=\n\n"
                    "[GroupOrder]\n0=Default\n")
        return f"新建了 fcitx5 输入法列表：键盘 {layout} + WowType"
    sections, current = {}, None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1]
            sections.setdefault(current, {})
        elif current and "=" in line and not line.startswith("#"):
            key, _, value = line.partition("=")
            sections[current][key.strip()] = value.strip()
    first = sections.get("GroupOrder", {}).get("0")
    index = next((name.split("/")[1] for name, keys in sections.items()
                  if re.fullmatch(r"Groups/\d+", name) and keys.get("Name") == first), None)
    if index is None:
        raise RuntimeError(f"看不懂 {path}，请在 fcitx5 配置里手动添加 WowType")
    items = [keys.get("Name") for name, keys in sections.items()
             if re.fullmatch(rf"Groups/{index}/Items/\d+", name)]
    if "wowtype" in items:
        return f"WowType 已经在输入法列表「{first}」里"
    with open(path + ".bak-wowtype", "w", encoding="utf-8") as f:
        f.write(text)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text.rstrip("\n") + f"\n\n[Groups/{index}/Items/{len(items)}]\nName=wowtype\nLayout=\n")
    return f"已把 WowType 加进输入法列表「{first}」（原来的存成 profile.bak-wowtype）"


def add_to_group_cli(restart, say=print):
    """安装脚本用（wowtype-config --add-to-group [--restart]）：把 WowType 加进当前输入法分组。

    fcitx5 在跑：认得 WowType 就经 D-Bus 加；不认得（刚装完）时带 --restart 先让它重启，
    否则返回 3。fcitx5 没在跑：直接改 profile。第一次配置 fcitx5 时顺手让出左 Shift
    （free_left_shift_first_time）。成功（含本来就在）返回 0。
    """
    first = fcitx_first_time()
    known = fcitx_knows_wowtype()
    if known is None:
        say(profile_add_wowtype())
        if first:
            free_left_shift_first_time(False, say)
        return 0
    if not known and not restart:
        say("fcitx5 还没载入 WowType，要先重启 fcitx5")
        return 3
    if restart:
        # 认得也重启：升级时 fcitx5 里跑着的是旧插件，不重启新版不生效
        known = False
        restart_fcitx_sync()
        for _ in range(60):  # 最多等 15 秒
            time.sleep(0.25)
            known = fcitx_knows_wowtype()
            if known:
                break
        if not known:
            say("重启 fcitx5 以后还是找不到 WowType，请注销重新登录后在 fcitx5 配置里添加")
            return 1
        say("已重启 fcitx5")
    group = fcitx_call_sync("CurrentInputMethodGroup", None, "(s)").unpack()[0]
    info = fcitx_call_sync("InputMethodGroupInfo", GLib.Variant("(s)", (group,)), "(sa(ss))")
    layout, items = info.unpack()
    if any(name == "wowtype" for name, _ in items):
        say(f"WowType 已经在输入法列表「{group}」里")
        return 0
    items = list(items) + [("wowtype", "")]
    if fcitx_call_sync("SetInputMethodGroupInfo",
                       GLib.Variant("(ssa(ss))", (group, layout, items))) is None:
        say("添加失败，请在 fcitx5 配置里手动添加 WowType")
        return 1
    say(f"已把 WowType 加进输入法列表「{group}」")
    if first:
        free_left_shift_first_time(True, say)
    return 0


# ---------------------------------------------------------------- 一键设置
#
# 不走 install.sh、直接装 .deb / .rpm / Arch 包的用户：wowtype-config --setup 或设置第一页的「一键设置」
# 把 install.sh 以前做的几步做完：切输入法框架（im-config）、把 WowType 加进输入法列表、必要时重启 fcitx5。
# install.sh 现在也是调它。

def fcitx_user_config_file():
    return os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), "fcitx5", "config")


def fcitx_first_time():
    """用户还没有 fcitx5 的配置（输入法列表 profile、全局配置 config 都没有）：第一次配置 fcitx5。"""
    return not os.path.exists(PROFILE_FILE) and not os.path.exists(fcitx_user_config_file())


def fcitx_config_with_hotkeys(text, lists):
    """fcitx5 全局配置文件的原文里，把 {选项: [按键…]} 这几个快捷键换掉，别的行原样留着。

    写法和 fcitx5 存的一样（parse_fcitx_hotkey 读）：空列表是 [Hotkey] 下的「选项=」，
    非空是 [Hotkey/选项] 下的 0=、1=…"""
    drop = {f"Hotkey/{option}" for option in lists}
    out, section = [], None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
        elif section == "Hotkey" and stripped.partition("=")[0].strip() in lists:
            continue
        if section in drop:
            continue
        out.append(line)
    while out and not out[-1].strip():
        out.pop()
    empty = [option for option, keys in lists.items() if not keys]
    if empty:
        if "[Hotkey]" not in (line.strip() for line in out):
            out += ([""] if out else []) + ["[Hotkey]"]
        at = next(i for i, line in enumerate(out) if line.strip() == "[Hotkey]") + 1
        out[at:at] = [f"{option}=" for option in empty]
    for option, keys in lists.items():
        if keys:
            out += ([""] if out else []) + [f"[Hotkey/{option}]"] + [f"{i}={k}" for i, k in enumerate(keys)]
    return "\n".join(out) + "\n"


def free_left_shift_first_time(running, say=print):
    """第一次配置 fcitx5 时（fcitx_first_time），把 fcitx5 默认占着的左 Shift（「临时切换输入法」AltTriggerKeys）
    让给 WowType，不然单按左 Shift 切不了中英文。只在这一次做，已有配置的用户不动；设置「输入」页的开关能还回去
    （和那个开关一样记在 state 的 fcitx_shift_freed 里）。

    running：fcitx5 在跑就经 D-Bus 改（fcitx5 自己存文件）；没在跑就直接写 ~/.config/fcitx5/config。返回改了没有。"""
    toggle = read_config()[0].get("ShiftToggle", "Both")
    if "Shift_L" not in SHIFT_SIDES.get(toggle, ()):
        return False
    path = None
    if running:
        value = fcitx_call_sync("GetConfig", GLib.Variant("(s)", (GLOBAL_URI,)), "(va(sa(sssva{sv})))")
        hotkey = None if value is None else value.unpack()[0].get("Hotkey")
        if not isinstance(hotkey, dict):
            return False
    else:
        hotkey, path = saved_fcitx_hotkey()
    keys = key_list(hotkey.get("AltTriggerKeys"))
    if "Shift_L" not in keys:
        return False
    keys.remove("Shift_L")
    lists = {"AltTriggerKeys": keys}
    if running:
        if fcitx_call_sync("SetConfig", GLib.Variant("(sv)", (GLOBAL_URI, hotkey_config_variant(lists)))) is None:
            return False
    else:
        base = ""
        if path:  # 系统的默认配置（/etc/xdg/fcitx5/config）：用户的文件会整个盖掉它，别的项照抄
            try:
                with open(path, encoding="utf-8") as f:
                    base = f.read()
            except OSError:
                pass
        try:
            write_atomic(fcitx_user_config_file(), fcitx_config_with_hotkeys(base, lists))
        except OSError:
            return False
    freed = [list(k) for k in read_state().get("fcitx_shift_freed", [])]
    if ["AltTriggerKeys", "Shift_L"] not in freed:
        update_state(fcitx_shift_freed=freed + [["AltTriggerKeys", "Shift_L"]])
    log("第一次配置 fcitx5：把「临时切换输入法」的左 Shift 让给 WowType")
    say("左 Shift 让给了 WowType（单按切中英文），切换输入法用 Ctrl+空格；"
        "想还给 fcitx5，到「WowType 设置」的「输入」页关掉")
    return True


SETUP_OK, SETUP_FAILED, SETUP_RELOGIN, SETUP_RESTARTED, SETUP_UNFINISHED = 0, 1, 2, 3, 4


def im_config_active():
    """im-config 的当前设置（用户设过的，没设过用系统的）；没有 im-config 或读不出来是 None。"""
    tool = shutil.which("im-config")
    if not tool:
        return None
    try:
        lines = subprocess.run([tool, "-m"], capture_output=True, text=True, timeout=10).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return None
    # 第 1 行系统的设置，第 2 行当前用户的（没设过是 missing）
    active = lines[1].strip() if len(lines) > 1 else ""
    if active in ("", "missing"):
        active = lines[0].strip() if lines else ""
    return active or None


def own_im_framework():
    """系统自己管输入法框架、不该去动的：deepin（默认就是 fcitx5，经 deepin-im）。"""
    return read_os_release().get("ID", "").lower() == "deepin"


def setup_action(known, im_active):
    """一键设置该做什么。known 是 fcitx_knows_wowtype() 的结果；im_active 是能用 im-config 切时它现在的设置，否则 None。

    add       fcitx5 在跑、认得 WowType：加进输入法列表
    restart   在跑、不认得（刚装完还没载入新插件）：重启它再加
    im-config 没在跑，框架不是 fcitx5（Ubuntu 默认 IBus）：im-config -n fcitx5、写好输入法列表，注销重新登录
    profile   没在跑，框架已经是 fcitx5（或者没有 im-config、不让改）：写好输入法列表，等 fcitx5 下次启动"""
    if known:
        return "add"
    if known is False:
        return "restart"
    if im_active is not None and im_active != "fcitx5":
        return "im-config"
    return "profile"


def setup_question(action, im_active):
    """这一步要先问用户的话（不用问是 None）。"""
    if action == "im-config":
        return f"现在的输入法框架是「{im_active}」，切换到 fcitx5 吗？（要注销重新登录一次）"
    if action == "restart":
        return "fcitx5 正在运行，要重启一次才能载入 WowType。现在重启它并把 WowType 加进输入法列表吗？" + RESTART_NOTE
    return None


def framework_hint(im_allowed):
    """fcitx5 没在跑、也没有 im-config 可用时，告诉用户怎么让桌面启动 fcitx5。"""
    if not im_allowed or own_im_framework() or shutil.which("im-config"):
        return None
    return f"请在桌面设置中启用 Fcitx 5 并注销重新登录；Wayland / X11 的配置见 {INSTALL_GUIDE}"


def run_setup(action, confirmed, first=False, say=print, allow_restart=True, hint=None):
    """按 setup_action 做（confirmed：setup_question 问过、用户答应了）。返回 SETUP_*：

    SETUP_OK 现在就能用；SETUP_RESTARTED 刚重启了 fcitx5（Chromium / Electron 程序要重开）；
    SETUP_RELOGIN 要注销重新登录；SETUP_UNFINISHED 用户没答应或不让重启，还差一步；SETUP_FAILED 出错。"""
    if action == "restart" and not (confirmed and allow_restart):
        say("没重启 fcitx5。之后重启它（wowtype-config --restart-fcitx）或注销再登录，"
            "再运行 wowtype-config --setup，或在「WowType 设置」第一页点「一键设置」")
        return SETUP_UNFINISHED
    if action in ("add", "restart"):
        if add_to_group_cli(action == "restart", say) != 0:
            return SETUP_FAILED
        return SETUP_RESTARTED if action == "restart" else SETUP_OK
    code = SETUP_RELOGIN
    if action == "im-config":
        if not confirmed:
            say("没切换输入法框架，WowType 要在 fcitx5 下才能用")
            code = SETUP_UNFINISHED
        elif subprocess.run(["im-config", "-n", "fcitx5"], stdin=subprocess.DEVNULL).returncode == 0:
            log("一键设置：im-config -n fcitx5")
            say("已把输入法框架切到 fcitx5（im-config）")
        else:
            say("im-config 切换失败，请手动运行：im-config -n fcitx5，然后注销重新登录")
            code = SETUP_UNFINISHED
    elif hint:
        say(hint)
    try:
        say(profile_add_wowtype())
    except (OSError, RuntimeError) as e:
        say(str(e))
        return SETUP_FAILED
    if first:
        free_left_shift_first_time(False, say)
    return code


def ask_terminal(question, yes=False):
    """命令行里问一句，默认「是」；没有终端（或 --yes）时直接按「是」（和 install.sh 一样）。"""
    if yes or not sys.stdin.isatty():
        return True
    try:
        answer = input(f"{question} [Y/n] ").strip()
    except EOFError:
        return True
    return not answer or answer[0] in "Yy是"


def setup_cli(args):
    """wowtype-config --setup [--yes] [--no-im-config] [--no-restart]：见 run_setup，退出码是它的 SETUP_*。

    环境变量 WOWTYPE_YES、WOWTYPE_NO_IM_CONFIG、WOWTYPE_NO_RESTART 和对应的选项一样（install.sh 也认这几个）。"""
    yes = "--yes" in args or bool(os.environ.get("WOWTYPE_YES"))
    im_allowed = not ("--no-im-config" in args or os.environ.get("WOWTYPE_NO_IM_CONFIG"))
    allow_restart = not ("--no-restart" in args or os.environ.get("WOWTYPE_NO_RESTART"))
    first = fcitx_first_time()
    known = fcitx_knows_wowtype()
    im_active = im_config_active() if im_allowed and known is None and not own_im_framework() else None
    if known and restart_needed(running_addon_version()):
        known = False  # 认得，但跑着的还是旧插件（刚升级）：照「不认得」处理，先问再重启一次载入新版
    action = setup_action(known, im_active)
    question = setup_question(action, im_active)
    confirmed = (question is None or (action == "restart" and not allow_restart)
                 or ask_terminal(question, yes))
    code = run_setup(action, confirmed, first, lambda text: print(f"WowType：{text}"),
                     allow_restart, framework_hint(im_allowed))
    log(f"一键设置（命令行）：{action}，结果 {code}")
    return code


def setup_hint(known, in_group):
    """装完还差哪一步（给 --notify-setup 的通知）：(标题, 正文)，什么都不差是 None。"""
    if known and in_group:
        return None
    where = "打开应用菜单里的「WowType 设置」，"
    if known:
        return "WowType 已安装，还没加进输入法列表", where + "在第一页点「添加」。"
    if known is False:
        return "WowType 已安装，要重启一次输入法", where + "在第一页点「重启并添加」。" + RESTART_NOTE
    return ("WowType 已安装，还差一步",
            where + "在第一页点「一键设置」：切到 fcitx5 输入法框架、写好输入法列表，然后注销重新登录。")


def notify_setup_cli():
    """wowtype-config --notify-setup：deb 的 postinst 以已登录的图形会话用户身份调它。
    还差哪一步就发一条通知（不带按钮，不等，GNOME 上点通知会打开设置），不改任何设置。"""
    known = fcitx_knows_wowtype()
    in_group = False
    if known:
        group = fcitx_call_sync("CurrentInputMethodGroup", None, "(s)")
        info = group and fcitx_call_sync("InputMethodGroupInfo", GLib.Variant("(s)", group.unpack()), "(sa(ss))")
        in_group = bool(info) and any(name == "wowtype" for name, _ in info.unpack()[1])
    hint = setup_hint(known, in_group)
    if hint:
        notify(*hint)
    return 0


def classicui_theme_values(on):
    # fcitx5 经典界面（KDE、X11 等）：浅色/深色各一套，跟随系统深浅色
    if on:
        return {"Theme": THEME_LIGHT, "DarkTheme": THEME_DARK, "UseDarkTheme": "True"}
    return {"Theme": "default", "DarkTheme": "default-dark"}


def apply_gnome_theme(on):
    """GNOME 上候选框是 Input Method Panel（kimpanel）扩展画的，换色靠另一个小扩展。

    返回给用户看的一句话；不是 GNOME 时返回 None。
    """
    shell = gnome_shell_settings()
    if shell is None:
        return None
    # GNOME 44 及以前（比如 Ubuntu 22.04 的 GNOME 42）扫到这个扩展也只标「版本不符」，不加载
    if on and int(gnome_extension_info(GNOME_THEME_EXT).get("state", 0)) == GNOME_EXT_OUT_OF_DATE:
        return "这个 GNOME 太旧，候选框换不了色（WowType 主题扩展要 GNOME 45 以上）"
    set_gnome_extension(shell, GNOME_THEME_EXT, on)
    if not on:
        return "已换回默认配色"
    if KIMPANEL_EXT not in shell.get_strv("enabled-extensions"):
        return "GNOME 上要先装并启用 Input Method Panel 扩展，候选框才会用这个主题"
    if not gnome_extension_loaded(GNOME_THEME_EXT):
        return "注销并重新登录一次后生效（GNOME 新装的扩展要重新登录才加载）"
    return "已换成 WowType 主题"


def init_default_theme():
    """第一次用 WowType 时把绿色主题打开（只做一次，之后听用户的）。

    不覆盖用户自己选的别的 fcitx5 主题；GNOME 上用户关过这个扩展的也不动。
    fcitx5 还没起来时什么都不做，下次再试。
    """
    if read_state().get("theme_default_done"):
        return
    value = fcitx_call_sync("GetConfig", GLib.Variant("(s)", (CLASSICUI_URI,)),
                            "(va(sa(sssva{sv})))")
    if value is None:
        return
    shell = gnome_shell_settings()
    if shell is not None and GNOME_THEME_EXT in shell.get_strv("disabled-extensions"):
        update_state(theme_default_done=True)
        log("默认主题：用户在 GNOME 里关过 WowType 主题，不动")
        return
    current = value.unpack()[0].get("Theme", "default")
    if current in ("default", "", THEME_LIGHT):
        raw = GLib.Variant("a{sv}", {k: GLib.Variant("s", v)
                                     for k, v in classicui_theme_values(True).items()})
        fcitx_call_sync("SetConfig", GLib.Variant("(sv)", (CLASSICUI_URI, raw)))
        log(f"默认主题：fcitx5 经典界面 {current or 'default'} -> {THEME_LIGHT}")
    else:
        log(f"默认主题：用户在用别的主题 {current}，不动")
    if shell is not None:
        log(f"默认主题：GNOME 扩展 {apply_gnome_theme(True)}")
    update_state(theme_default_done=True)


def startup_tasks():
    """插件切到 WowType 时在后台叫（wowtype-config --startup），最多一小时一次。"""
    try:
        init_default_theme()
    except Exception as e:  # 主题弄不好也别耽误检查更新
        log(f"默认主题失败：{e!r}")

    # 提醒重启的通知要等用户点（最长一天），放到另一个线程里等，不耽误检查更新；进程等它结束再退出
    def remind():
        try:
            restart_reminder()
        except Exception as e:  # noqa: BLE001
            log(f"提醒重启输入法失败：{e!r}")
    threading.Thread(target=remind).start()
    return background_check()


# ---------------------------------------------------------------- 诊断信息


def _home(text):
    home = os.path.expanduser("~")
    return text.replace(home, "~") if home and home != "/" else text


def _run(cmd, timeout=10):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (out.stdout + out.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return f"（{cmd[0]} 运行失败：{e}）"


def _tail(path, lines):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().splitlines()[-lines:]
    except OSError:
        return []


def _file_line(path):
    if not path:
        return None
    try:
        st = os.stat(path)
    except OSError:
        return f"  {path}：没有"
    if os.path.isdir(path):
        size = dir_size(path)
    else:
        size = st.st_size
    stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime))
    return f"  {path}：{size / 1e6:.1f} MB，{stamp}"


def _data_version_note(path):
    """诊断信息里数据文件的版本：「版本 2026.11.14.6（来源）」或「没有版本标记」。"""
    if not os.path.isfile(path):
        return ""
    marker = read_data_marker(path)
    if marker and marker[0] != os.path.basename(path):
        # 别的数据（万象词库包的标记名字是 wanxiang/lexicon.tsv）
        return f"，{marker[0]} 版本 {marker[1]}" + (f"（{marker[2]}）" if marker[2] else "")
    found = data_file_version(path)
    if not found:
        return "，没有版本标记"
    version, source = found
    return f"，版本 {version}" + (f"（{source}）" if source else "")


def _count_lines(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return sum(1 for line in f if line.strip() and not line.startswith("#"))
    except OSError:
        return None


def collect_diagnostics():
    """导出给开发者看的诊断信息（纯文本）。

    不含打过的字、自定义词和输入习惯的内容（只有条数），家目录写成 ~。
    """
    out = []
    add = out.append
    add("# WowType 诊断信息")
    add(f"导出时间：{time.strftime('%Y-%m-%d %H:%M:%S %z')}")
    add("不含你打过的字、自定义词和输入习惯的内容（只有条数和大小）。")
    add("")
    add("## 版本")
    add(f"设置界面：{current_version()}")
    manager, _distro, _arch, _reason = update_platform()
    add(f"{ENGINE_PKG}：{package_version(manager) or '源码或系统配置管理的安装'}")
    if dpkg_version(DATA_PKG):  # 0.3.3 及以前词库是单独的包
        add(f"{DATA_PKG}：{dpkg_version(DATA_PKG)}")
    try:
        with open(DATA_VERSION_FILE, encoding="utf-8") as f:
            add(f"安装包里的词库：{f.read().strip()}")
    except OSError:
        pass
    add(f"fcitx5：{_run(['fcitx5', '--version'])}")
    os_name = ""
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    os_name = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    add(f"系统：{os_name}，内核 {os.uname().release}，{os.uname().machine}")
    for key in ("XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE", "LANG", "GTK_IM_MODULE",
                "QT_IM_MODULE", "XMODIFIERS"):
        add(f"{key}={os.environ.get(key, '')}")
    add("")

    add("## fcitx5")
    group = fcitx_call_sync("CurrentInputMethodGroup", None, "(s)")
    if group is None:
        add("fcitx5 没在运行（或连不上 D-Bus）")
    else:
        name = group.unpack()[0]
        info = fcitx_call_sync("InputMethodGroupInfo", GLib.Variant("(s)", (name,)), "(sa(ss))")
        items = [im for im, _layout in info.unpack()[1]] if info else []
        add(f"输入法组 {name}：{', '.join(items)}")
        current = fcitx_call_sync("CurrentInputMethod", None, "(s)")
        if current is not None:
            add(f"当前输入法：{current.unpack()[0]}")
        theme = fcitx_call_sync("GetConfig", GLib.Variant("(s)", (CLASSICUI_URI,)),
                                "(va(sa(sssva{sv})))")
        if theme is not None:
            cfg = theme.unpack()[0]
            add(f"经典界面主题：{cfg.get('Theme')} / {cfg.get('DarkTheme')}，"
                f"跟随深色 {cfg.get('UseDarkTheme')}")
    shell = gnome_shell_settings()
    if shell is not None:
        enabled = shell.get_strv("enabled-extensions")
        states = {1: "在运行", 2: "已停用", 3: "出错", 4: "版本不兼容"}
        for uuid in (KIMPANEL_EXT, GNOME_THEME_EXT):
            info = gnome_extension_info(uuid)
            state = states.get(int(info.get("state", 0)), f"状态 {info.get('state')}") \
                if info else "这次登录没加载"
            error = f"，错误：{info['error']}" if info.get("error") else ""
            add(f"GNOME 扩展 {uuid}：{'已启用' if uuid in enabled else '没启用'}，{state}{error}")
    add("")

    add("## WowType 设置（wowtype.conf）")
    values, _extra = read_config()
    values["TranslateBaseUrl"] = mask_url(values["TranslateBaseUrl"])
    add(", ".join(f"{k}={v}" for k, v in values.items()))
    add(f"互译 Key：{'已设置' if read_translate_key() else '没设置'}")
    add("")

    add("## 数据文件")
    kind, path = active_lexicon(values)
    label = {"rime-ice": "雾凇（默认）", "wanxiang": "万象", "custom": "自己指定"}[kind]
    add(f"  词库：{label}" + (f"，{path}" if path else ""))
    add(f"  万象词库包：{lexicon_pack_version() or '没装'}")
    nnlm_kind, nnlm_path = active_nnlm()
    nnlm_label = {"env": "环境变量 WOWTYPE_NNLM 指定的", "imported": "导入的微信输入法模型",
                  "bundled": "WowType 自带的 nnlm.bin", None: "没有"}[nnlm_kind]
    add(f"  整句增强模型：{nnlm_label}" + (f"，{nnlm_path}" if nnlm_path else ""))
    data_files = {os.path.join(folder, name) for folder in (DATA_DIR, SYSTEM_DATA_DIR)
                  for name in DATA_FILES} | {WANXIANG_LEXICON}
    for path in [*LEXICON_CANDIDATES, WANXIANG_LEXICON, WANXIANG_LEXICON + ".wcache",
                 os.path.join(DATA_DIR, "english.txt"), "/usr/share/wowtype/english.txt",
                 os.environ.get("WOWTYPE_LM", ""),
                 os.path.join(DATA_DIR, "words.lm"), "/usr/share/wowtype/words.lm",
                 os.environ.get("WOWTYPE_NNLM", ""),
                 os.path.join(DATA_DIR, "nnlm.bin"), os.path.join(SYSTEM_DATA_DIR, "nnlm.bin"),
                 *WUBI_CANDIDATES,
                 os.path.join(DATA_DIR, "s2t.tsv"), os.path.join(SYSTEM_DATA_DIR, "s2t.tsv"),
                 os.path.join(DATA_DIR, "lexicon.tsv.wcache"),
                 os.path.join(DATA_DIR, "wetype", "nlrgpt2_nnlm.bin"),
                 VOICE_MODEL_DIR]:
        line = _file_line(path)
        if line:
            if path in data_files or os.path.basename(path) in DATA_FILES:
                line += _data_version_note(path)
            system = os.path.join(SYSTEM_DATA_DIR, os.path.basename(path))
            if (path.startswith(DATA_DIR + os.sep) and os.path.isfile(path)
                    and stale_bundled_copy(path, system)):
                line += "（安装包自带数据的旧副本，版本不比安装包带的新，插件改用系统目录那份，这份可以删掉）"
            add(line)
    manifest = read_data_manifest()
    if manifest:
        add(f"  数据清单 {DATA_MANIFEST}：")
        for name, version, source in manifest:
            add(f"    {name} {version}" + (f"（{source}）" if source else ""))
    else:
        add(f"  数据清单 {DATA_MANIFEST}：没有（老安装包）")
    for label, path in (("自定义词", CUSTOM_FILE),
                        ("自动学到的词", os.path.join(DATA_DIR, "user.tsv")),
                        ("输入习惯", os.path.join(DATA_DIR, "history.tsv"))):
        count = _count_lines(path)
        add(f"  {label}：{'没有' if count is None else f'{count} 条'}")
    add("")

    add("## WowType 日志（最近 400 行）")
    lines = _tail(LOG_FILE + ".1", 400) + _tail(LOG_FILE, 400)
    out.extend(lines[-400:] or ["（还没有日志：要用新版的 WowType 打过一次字才会有）"])
    add("")

    add("## fcitx5 日志（这次开机，最近 300 行）")
    add(_run(["journalctl", "--user", "-b", "--no-pager", "-o", "short-iso", "-n", "300",
              "_COMM=fcitx5"], timeout=20) or "（没有）")
    return _home("\n".join(out)) + "\n"


