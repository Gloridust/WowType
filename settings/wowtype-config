def llama_asset(machine=None, nixos=None):
    """这台机器能用的官方包：（下载地址, 大小, sha256）。没有合适的返回 None。

    NixOS 跑不了官方二进制（没有 /lib64/ld-linux），要在系统配置里装 llama-cpp。"""
    machine = os.uname().machine if machine is None else machine
    nixos = os.path.exists("/etc/NIXOS") if nixos is None else nixos
    if nixos or machine not in LLAMA_ASSETS:
        return None
    name, size, sha256 = LLAMA_ASSETS[machine]
    url = os.environ.get("WOWTYPE_LLAMA_URL") or (
        f"{LLAMA_PAGE}/releases/download/{LLAMA_BUILD}/llama-{LLAMA_BUILD}-bin-{name}.tar.gz")
    return url, size, os.environ.get("WOWTYPE_LLAMA_SHA256") or sha256


def downloaded_llama_server(root=None):
    path = os.path.join(root or LLAMA_DIR, "llama-server")
    return path if os.path.isfile(path) and os.access(path, os.X_OK) else None


def find_llama_server(setting="", downloaded=None):
    """llama-server 在哪：写了路径就看路径；只写名字（或空着）先在 PATH 里找，再看设置里下载的
    那份。找不到返回 None。和核心 LocalConfig::server_path 一个顺序。"""
    name = setting.strip() or "llama-server"
    if "/" in name:
        path = os.path.expanduser(name)
        return path if os.path.isfile(path) and os.access(path, os.X_OK) else None
    return shutil.which(name) or (downloaded_llama_server() if downloaded is None else downloaded)


def unpack_llama(archive, root):
    """把官方包解到 root（先解到 root.new，能跑了再换上去）。只要 llama-server 和它的动态库。

    包里的路径、链接都查一遍，不往目录外面写。llama-server 跑不起来（缺系统库、glibc 太旧）时
    抛 ValueError，带上它报的错。"""
    import tarfile
    fresh = root + ".new"
    shutil.rmtree(fresh, ignore_errors=True)
    os.makedirs(fresh)
    try:
        with tarfile.open(archive, "r:gz") as tar:
            for member in tar:
                name = os.path.basename(member.name)
                parts = member.name.split("/")
                if ".." in parts or member.name.startswith("/") or len(parts) != 2:
                    continue  # 只要顶层目录下的文件
                wanted = name == "llama-server" or (name.startswith("lib") and ".so" in name)
                if not wanted:
                    continue
                target = os.path.join(fresh, name)
                if member.issym():
                    if "/" in member.linkname or member.linkname in ("", ".", ".."):
                        raise ValueError(f"包里的链接不对：{member.name}")
                    os.symlink(member.linkname, target)
                elif member.isfile():
                    with tar.extractfile(member) as src, open(target, "wb") as out:
                        shutil.copyfileobj(src, out)
                    os.chmod(target, 0o755)
        server = os.path.join(fresh, "llama-server")
        if not os.path.isfile(server):
            raise ValueError("包里没有 llama-server")
        try:
            run = subprocess.run([server, "--version"], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise ValueError(f"llama-server 跑不起来：{e}") from e
        if run.returncode != 0:
            lines = (run.stderr or run.stdout).strip().splitlines()
            raise ValueError("llama-server 跑不起来：" + (lines[-1] if lines else f"退出码 {run.returncode}"))
        with open(os.path.join(fresh, "VERSION"), "w", encoding="utf-8") as f:
            f.write(LLAMA_BUILD + "\n")
        shutil.rmtree(root, ignore_errors=True)
        os.replace(fresh, root)
    except (tarfile.TarError, EOFError) as e:
        raise ValueError(f"包解不开：{e}") from e
    finally:
        shutil.rmtree(fresh, ignore_errors=True)
    return os.path.join(root, "llama-server")


def install_llama_server(progress=None, cancelled=None, root=None, asset=None):
    """下载官方包、校验、解到 LLAMA_DIR。返回 llama-server 的路径。

    这台机器没有合适的包、校验不过、跑不起来抛 ValueError；网络出错抛 OSError。"""
    asset = asset or llama_asset()
    if not asset:
        raise ValueError("这台机器没有现成的 llama-server 可以下载，请自己装 llama.cpp")
    url, _size, sha256 = asset
    root = root or LLAMA_DIR
    archive = root + ".tar.gz"
    download_model(archive, url, sha256, progress=progress, cancelled=cancelled)
    try:
        return unpack_llama(archive, root)
    finally:
        os.unlink(archive)


def remove_llama_server(root=None):
    shutil.rmtree(root or LLAMA_DIR, ignore_errors=True)


class DownloadCancelled(Exception):
    pass


def _digest_of(path, algo="sha256"):
    digest = hashlib.new(algo)
    with open(path, "rb") as f:
        while chunk := f.read(1 << 20):
            digest.update(chunk)
    return digest


def download_model(dest, url=None, sha256=None, progress=None, cancelled=None, timeout=30,
                   algo="sha256"):
    """下载到 dest（先写 dest.part，断了能接着下），校验 SHA256（algo="md5" 时 sha256 给 MD5）后改名。

    progress(已下载, 总大小) 时不时调一下；cancelled() 返回 True 时停下（.part 留着下次续）。
    校验不过就删掉 .part 抛 ValueError；网络出错抛 OSError。"""
    url = url or LOCAL_MODEL_URL
    sha256 = (sha256 or LOCAL_MODEL_SHA256).lower()
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    have = os.path.getsize(part) if os.path.exists(part) else 0
    request = urllib.request.Request(url, headers={"User-Agent": f"WowType/{current_version()}"})
    if have:
        request.add_header("Range", f"bytes={have}-")
    try:
        response = urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as e:
        if e.code != 416 or not have:
            raise
        response = None  # .part 已经下完整了，只差校验
    done = have
    if response is None:
        digest = _digest_of(part, algo)
    else:
        with response:
            if have and response.status != 206:
                have = done = 0  # 服务不支持续传：从头来
            length = int(response.headers.get("Content-Length") or 0)
            total = have + length if length else 0
            digest = _digest_of(part, algo) if have else hashlib.new(algo)
            last = 0.0
            with open(part, "ab" if have else "wb") as out:
                while chunk := response.read(1 << 16):
                    if cancelled and cancelled():
                        raise DownloadCancelled()
                    out.write(chunk)
                    digest.update(chunk)
                    done += len(chunk)
                    now = time.monotonic()
                    if progress and now - last > 0.2:
                        last = now
                        progress(done, total)
    if digest.hexdigest() != sha256:
        os.unlink(part)
        raise ValueError(f"下载的文件校验不对（{algo.upper()} 不一致），已删除，请重试")
    os.replace(part, dest)
    if progress:
        progress(done, done)
    return dest


def download_model_cli():
    """命令行下载本地翻译模型。Apache-2.0 许可，不用另外确认（以前的 --accept-license 还认，不起作用）。"""
    print(LOCAL_MODEL_TERMS)
    print(f"许可全文：{LOCAL_MODEL_LICENSE}\n")
    dest = os.path.join(MODELS_DIR, LOCAL_MODEL_FILE)

    def progress(done, total):
        text = f"{human_size(done)} / {human_size(total)}" if total else human_size(done)
        print(f"\r下载中 {text}   ", end="", flush=True)
    try:
        if os.path.isfile(dest):
            print(f"模型已经有了：{dest}")
        else:
            download_model(dest, progress=progress)
            print(f"\n模型好了：{dest}")
        if freed := remove_legacy_model():
            print(f"已删除上一代的 {LEGACY_MODEL_NAME}，空出 {human_size(freed)}")
        if server := find_llama_server(read_config().get("TranslateLlamaServer", "")):
            print(f"llama-server：{server}")
        elif llama_asset():
            print(f"系统里没有 llama-server，从 {LLAMA_PAGE} 下载 {LLAMA_BUILD}")
            print(f"\nllama-server 好了：{install_llama_server(progress=progress)}")
        else:
            print("系统里没有 llama-server，这台机器也没有现成的可以下载，请自己装 llama.cpp")
            return 1
    except (OSError, ValueError) as e:
        print(f"\n没下完：{e}（再跑一次会接着下）")
        return 1
    except KeyboardInterrupt:
        print("\n已暂停，再跑一次会接着下")
        return 130
    return 0


def llama_self_test():
    """unpack_llama / install_llama_server：只留 llama-server 和动态库、不往外写、跑不起来就不装。"""
    import io
    import tarfile
    import tempfile

    def pack(path, files, links=()):
        with tarfile.open(path, "w:gz") as tar:
            for name, body in files:
                info = tarfile.TarInfo(name)
                info.size = len(body)
                info.mode = 0o755
                tar.addfile(info, io.BytesIO(body))
            for name, to in links:
                info = tarfile.TarInfo(name)
                info.type = tarfile.SYMTYPE
                info.linkname = to
                tar.addfile(info)

    ok = b"#!/bin/sh\necho version: test\n"
    with tempfile.TemporaryDirectory() as tmp:
        root = os.path.join(tmp, "llama")
        archive = os.path.join(tmp, "a.tar.gz")
        pack(archive, [("llama-x/llama-server", ok), ("llama-x/libllama.so.0.9", b"lib"),
                       ("llama-x/llama-cli", ok), ("llama-x/../../evil", b"x"),
                       ("llama-x/sub/libdeep.so", b"x")],
             [("llama-x/libllama.so", "libllama.so.0.9")])
        server = unpack_llama(archive, root)
        assert server == downloaded_llama_server(root)
        assert sorted(os.listdir(root)) == ["VERSION", "libllama.so", "libllama.so.0.9", "llama-server"]
        assert os.readlink(os.path.join(root, "libllama.so")) == "libllama.so.0.9"
        assert not os.path.exists(os.path.join(tmp, "evil")) and not os.path.exists(root + ".new")
        assert find_llama_server("", downloaded=server) in (shutil.which("llama-server"), server)
        # 跑不起来的不装，原来那份留着
        pack(archive, [("llama-x/llama-server", b"#!/bin/sh\necho 'libgomp.so.1: not found' >&2\nexit 127\n")])
        try:
            unpack_llama(archive, root)
            raise AssertionError("跑不起来的 llama-server 不该装上")
        except ValueError as e:
            assert "libgomp" in str(e), e
        assert downloaded_llama_server(root) == server and not os.path.exists(root + ".new")
        for bad in ([("llama-x/readme", b"x")], None):
            if bad is None:
                with open(archive, "wb") as f:
                    f.write(b"not a tarball")
            else:
                pack(archive, bad)
            try:
                unpack_llama(archive, root)
                raise AssertionError("坏包不该装上")
            except ValueError:
                pass
        # 指到目录外面的链接
        pack(archive, [("llama-x/llama-server", ok)], [("llama-x/libx.so", "../../etc/passwd")])
        try:
            unpack_llama(archive, root)
            raise AssertionError("链接指到外面")
        except ValueError:
            pass
        # 整条路：下载、校验、解包；校验不对不装
        pack(archive, [("llama-x/llama-server", ok)])
        good = hashlib.sha256(open(archive, "rb").read()).hexdigest()
        url = "file://" + urllib.request.pathname2url(archive)
        fresh = os.path.join(tmp, "fresh")
        assert install_llama_server(root=fresh, asset=(url, 0, good)) == downloaded_llama_server(fresh)
        assert not os.path.exists(fresh + ".tar.gz")
        remove_llama_server(fresh)
        assert downloaded_llama_server(fresh) is None
        try:
            install_llama_server(root=fresh, asset=(url, 0, "0" * 64))
            raise AssertionError("校验不对")
        except ValueError:
            pass
        assert downloaded_llama_server(fresh) is None
    assert llama_asset("x86_64", False)[0].endswith(f"llama-{LLAMA_BUILD}-bin-ubuntu-x64.tar.gz") \
        or os.environ.get("WOWTYPE_LLAMA_URL")
    assert llama_asset("x86_64", True) is None and llama_asset("riscv64", False) is None
    assert llama_asset("aarch64", False)[2] == (
        os.environ.get("WOWTYPE_LLAMA_SHA256") or LLAMA_ASSETS["aarch64"][2])


