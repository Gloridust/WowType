<?xml version="1.0" encoding="utf-8"?>
<!-- build.sh 把版本号填进来，用 productbuild 打成 WowType-<版本>-macos.pkg。
     只装给当前用户（~/Library/Input Methods），不要管理员密码；装完 postinstall 登记并切到 WowType。 -->
<installer-gui-script minSpecVersion="2">
    <title>WowType @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="wowtype"/>
    </choices-outline>
    <choice id="wowtype" title="WowType" visible="false">
        <pkg-ref id="io.github.gloridust.inputmethod.WowType.pkg"/>
    </choice>
    <pkg-ref id="io.github.gloridust.inputmethod.WowType.pkg" version="@VERSION@" onConclusion="none">WowType-component.pkg</pkg-ref>
</installer-gui-script>
