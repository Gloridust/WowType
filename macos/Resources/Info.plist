<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- build.sh 把 @VERSION@ 换成版本号。参照 Squirrel：bundle ID 里带 .inputmethod.，
     输入模式 ID 以 bundle ID 开头；连接名只要唯一（Squirrel 用 Squirrel_Connection），这里用 <bundle ID>_Connection。 -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>WowType</string>
	<key>CFBundleExecutable</key>
	<string>WowType</string>
	<!-- 设置窗口（WowType --settings）在程序坞里的图标，build.sh 生成；菜单栏里的图标是下面的 menu.pdf -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.gloridust.inputmethod.WowType</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>WowType</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSBackgroundOnly</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>TISInputSourceID</key>
	<string>io.github.gloridust.inputmethod.WowType</string>
	<key>InputMethodConnectionName</key>
	<string>io.github.gloridust.inputmethod.WowType_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>WowTypeInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>WowTypeInputController</string>
	<!-- 图标是单色模板图（icons/macos/make-icons.swift 生成的矢量 PDF）：黑色 + 透明，系统按菜单栏深浅色上色，
	     和系统自带的输入法、微信输入法一样。menu.pdf 是 16pt 的圆里挖出 W；caret@2x.pdf 只有 W，
	     切换输入法时光标旁的提示气泡用它（TISIconLabels → CustomIcon，照系统自带的 AinuIM 写）。 -->
	<key>TISIconIsTemplate</key>
	<true/>
	<key>tsInputMethodIconFileKey</key>
	<string>menu.pdf</string>
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>io.github.gloridust.inputmethod.WowType.Hans</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>io.github.gloridust.inputmethod.WowType.Hans</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
				</array>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeKeyEquivalentModifiersKey</key>
				<integer>4608</integer>
				<key>TISIconLabels</key>
				<dict>
					<key>CustomIcon</key>
					<string>caret@2x.pdf</string>
				</dict>
				<key>tsInputModeMenuIconFileKey</key>
				<string>menu.pdf</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>menu.pdf</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>menu.pdf</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smUnicodeScript</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>io.github.gloridust.inputmethod.WowType.Hans</string>
		</array>
	</dict>
</dict>
</plist>
